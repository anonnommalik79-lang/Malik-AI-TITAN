// Stage 4 Project Builder GET route template.
// Disabled for static/export safety. Use Flask /api/ai/project/<id>.

export async function GET(_request: Request, context: { params: Promise<{ id: string }> }) {
  const { id } = await context.params
  return Response.json({ ok: false, id, error: "Enable server runtime or use Flask backend route." }, { status: 501 })
}
