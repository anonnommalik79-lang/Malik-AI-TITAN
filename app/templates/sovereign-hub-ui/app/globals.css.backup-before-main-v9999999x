  --secondary: #1f2937;
  --secondary-foreground: #f5f5f5;
  --muted: #111111;
  --muted-foreground: #737373;
  --accent: #1f2937;
  --accent-foreground: #f5f5f5;
  --destructive: #dc2626;
  --destructive-foreground: #fecaca;
  --border: #1f2937;
  --input: #1f2937;
  --ring: #ffffff;
  --chart-1: #3b82f6;
