// Stage 3 image API route template.
// Intentionally disabled because current Next app is static/export safe.
// Enable only after confirming active route handlers pass Render build.

import { createAIJob, runInMemoryMediaJob } from "@/lib/ai/jobs"
import { generateImageWithRouter, generateVideoWithRouter } from "@/lib/ai/media-router"
import { jobToHistoryItem } from "@/lib/ai/history"

export async function POST(request: Request) {
  try {
    const body = await request.json()
    const prompt = String(body?.prompt || "").trim()
    if (!prompt) return Response.json({ ok: false, error: "Prompt is required." }, { status: 400 })

    const job = createAIJob("image", {
      prompt,
      userId: body?.userId,
      userEmail: body?.userEmail,
      provider: body?.provider || "auto",
      style: body?.style,
      quality: body?.quality,
      aspectRatio: body?.aspectRatio,
      duration: body?.duration,
      metadata: body?.metadata,
    })

    queueMicrotask(() => {
      void runInMemoryMediaJob(job, async (currentJob) => {
        const result = await generateImageWithRouter({
          prompt: currentJob.input.prompt,
          userId: currentJob.input.userId,
          userEmail: currentJob.input.userEmail,
          task: "image",
          metadata: currentJob.input.metadata,
        })
        const output = typeof result.output === "object" ? result.output as any : { message: result.output }
        return {
          resultUrl: output.resultUrl,
          thumbnailUrl: output.thumbnailUrl,
          provider: String(output.provider || result.provider),
          model: result.model,
          message: typeof result.output === "string" ? result.output : output.message,
          raw: output,
        }
      })
    })

    return Response.json({ ok: true, jobId: job.id, status: job.status, job })
  } catch (error) {
    return Response.json({ ok: false, error: error instanceof Error ? error.message : String(error) }, { status: 500 })
  }
}
