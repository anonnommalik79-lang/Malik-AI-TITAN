# MALIK AI Voice — dedicated server-side credentials
# Put real values in Render Environment, never commit secrets.

GROQ_VOICE_API_KEY=
GROQ_WHISPER_PRIMARY=whisper-large-v3-turbo
GROQ_WHISPER_FALLBACK=whisper-large-v3

CLOUDFLARE_VOICE_API_TOKEN=
CLOUDFLARE_VOICE_ACCOUNT_ID=
CLOUDFLARE_WHISPER_PRIMARY=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_WHISPER_FALLBACK=@cf/openai/whisper
CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts

# Optional. Enables the official xAI/Grok built-in voice roster.
# Without it Malik AI falls back to Cloudflare MeloTTS + device SpeechSynthesis.
XAI_VOICE_API_KEY=

VOICE_DAILY_LIMIT_SECONDS=120
VOICE_PROVIDER_TIMEOUT_MS=15000
