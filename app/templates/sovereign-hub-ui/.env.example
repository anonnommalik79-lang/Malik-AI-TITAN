# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# AI routing — set false to allow premium providers (OpenAI, Claude, etc.)
AI_FREE_MODE=true
TEXT_PROVIDER_ORDER=groq,gemini,openrouter
CODE_PROVIDER_ORDER=groq,gemini,openrouter

# Upload size limits (MB)
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_VIDEO_MB=50
MAX_UPLOAD_DOC_MB=12

# Text and code providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CODE_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5
KIMI_CODE_MODEL=
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
NVIDIA_NIM_ENABLED=false
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=

# AWS (Bedrock chat/image + Translate + Polly TTS — all use the same keys)
# 1) Set the 3 keys below from IAM. 2) Enable model access in Bedrock console.
# 3) To use Bedrock for chat, set AI_FREE_MODE=false and add aws-bedrock to TEXT_PROVIDER_ORDER.
# Translate + Polly work as soon as the keys are set (separate API endpoints).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEDROCK_TEXT_MODEL=amazon.nova-pro-v1:0
AWS_BEDROCK_CODE_MODEL=amazon.nova-pro-v1:0
AWS_BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0
AWS_BEDROCK_VIDEO_MODEL=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Media API — Stability (primary) + Pollinations (fallback) + Pollo (video)
STABILITY_API_KEY=
POLLO_API_KEY=

IMAGE_PROVIDER_PRIMARY=pollinations
IMAGE_PROVIDER_FALLBACK=pollinations
IMAGE_FREE_MODE=true

POLLO_VIDEO_MODEL=pollo-v2-0
VIDEO_PROVIDER_PRIMARY=pollo
POLLO_VIDEO_ENABLED=false

GUEST_DAILY_IMAGE_LIMIT=3
FREE_DAILY_IMAGE_LIMIT=10
PREMIUM_DAILY_IMAGE_LIMIT=50

GUEST_DAILY_VIDEO_LIMIT=0
FREE_DAILY_VIDEO_LIMIT=1
PREMIUM_DAILY_VIDEO_LIMIT=5

MAX_IMAGE_PROMPT_LENGTH=1500
MAX_VIDEO_PROMPT_LENGTH=1500
POLLINATIONS_TIMEOUT_MS=45000

# Legacy image/video providers (not used by /api/media/*)
FAL_KEY=
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/minimax-video
LUMA_API_KEY=
LUMA_VIDEO_MODEL=ray-2
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4.5
GOOGLE_VEO_API_KEY=
VEO_API_KEY=
GOOGLE_VEO_MODEL=veo-3.1-generate-preview

# Provider order overrides (optional — TEXT/CODE defaults set above)
MEDIA_PROVIDER_ORDER=
VIDEO_PROVIDER_ORDER=
IMAGE_PROVIDER_ORDER=

# Optional backend proxy
MALIK_BACKEND_URL=
MALIK_BACKEND_PROXY_ENABLED=false

# WorkOS AuthKit (Google/GitHub and session cookie)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-characters
WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Voice (optional)
ELEVENLABS_API_KEY=
MALIK_ADMIN_USERS=amangeldymalik38@gmail.com,anonnommalik79@gmail.com
MALIK_ADMIN_TOKEN=
MALIK_DEBUG_PROVIDERS=false
MALIK_TELEGRAM_USERNAME=
MALIK_PAYMENT_WALLET_ADDRESS=TAdNa6wGagQDgoZituHUNEb7uxPgRAijno
REDIS_URL=
S3_BUCKET=
STORAGE_BUCKET=
R2_BUCKET=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Timeouts
PROVIDER_TIMEOUT_MS=30000
IMAGE_PROVIDER_TIMEOUT_MS=90000

# MALIK AI Live Research Mode
NEXT_PUBLIC_RESEARCH_MODE=true
RESEARCH_MAX_QUERIES=5
RESEARCH_MAX_PAGES=8
RESEARCH_MAX_TEXT=18000
RESEARCH_CACHE_TTL_MS=21600000

# Optional: self-hosted search for stable zero-token browsing
SEARXNG_URL=

# MALIK AI World Research V5
NEXT_PUBLIC_RESEARCH_MODE=true
RESEARCH_MAX_QUERIES=6
RESEARCH_MAX_PAGES=8
RESEARCH_MAX_TEXT=18000
RESEARCH_CACHE_TTL_MS=21600000

# Free fallbacks
JINA_SEARCH_URL=https://s.jina.ai/
JINA_SEARCH_DISABLED=false
JINA_READER_DISABLED=false

# Optional stronger search providers, add in Render for ChatGPT/Claude-level stability
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
# MALIK World Search Thinking V7
MALIK_WORLD_SEARCH_THINKING_V7=true

# MALIK ChatGPT Logic V10
MALIK_CHATGPT_LOGIC_V10=true
RESEARCH_TURBO=true
RESEARCH_TURBO_MAX_QUERIES=3
RESEARCH_TURBO_MAX_PAGES=3
RESEARCH_TURBO_SEARCH_TIMEOUT_MS=9000
RESEARCH_TURBO_READ_TIMEOUT_MS=5000
RESEARCH_TURBO_TOTAL_TIMEOUT_MS=16000
RESEARCH_TURBO_STREAM_TIMEOUT_MS=19000
# MALIK V13 - GitHub Models + OpenRouter + DeepSeek. No Gemini.
MALIK_GOD_PROVIDER_CHAIN=github,openrouter,deepseek
MALIK_GOD_SHOW_PROVIDER=false
MALIK_GOD_MAX_OUTPUT_TOKENS=2200
MALIK_GOD_PROVIDER_TIMEOUT_MS=18000
MALIK_GOD_MAX_SEARCH_QUERIES=3
MALIK_GOD_SEARCH_PER_QUERY=6
MALIK_GOD_MAX_SOURCES=8
MALIK_GOD_CACHE_TTL_MS=1200000

GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference

OPENROUTER_API_KEY=
OPENROUTER_MODEL_ORDER=moonshotai/kimi-k2,qwen/qwen-max,z-ai/glm-4.5,deepseek/deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Web search keys
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
JINA_SEARCH_URL=https://s.jina.ai/
JINA_SEARCH_DISABLED=false
