# Malik AI — publishing to Instagram
#
# What this is NOT: a place to put an Instagram password. Malik AI never sees
# one. The person authorises the app inside Instagram's own window and
# Instagram hands back a token, which is encrypted before it is written down
# and bound to the account it belongs to.
#
# Setup, once, at developers.facebook.com:
#
#  1. Create an app → use case "Instagram" → add the product
#     "Instagram API setup with Instagram login".
#  2. The Instagram account you will post from must be Business or Creator.
#     A personal account cannot publish through the API — switch it in the
#     Instagram app under Settings → Account type and tools.
#  3. In "Business login settings", set the redirect URI to exactly:
#       https://<your-domain>/api/instagram/callback
#     Meta matches it character for character, including the trailing path.
#  4. Copy the Instagram app ID and app secret below.
#  5. Add your own Instagram account as a tester on the app (Roles → add
#     people). Until Meta approves `instagram_business_content_publish` for
#     public use, publishing works for accounts with a role on the app —
#     which is enough to run it and to demonstrate it.
#
# App Review for public users takes days to weeks and needs business
# verification. Plan for it separately; it is not a switch you flip on the day.

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Must be https and must end in /api/instagram/callback. Left empty, it is
# derived from APP_URL.
INSTAGRAM_REDIRECT_URI=https://malikaiworld.world/api/instagram/callback

# 32 bytes, as 64 hex characters or base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it distinct from every other key in the app: one leaked secret should
# not open every connected service at once.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# The connection is stored through the existing private JSON store, so the
# PRIVATE_STATE_* variables the chat history already uses must be set too.
