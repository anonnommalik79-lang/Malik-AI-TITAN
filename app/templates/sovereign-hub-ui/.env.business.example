# Malik AI Business System
# Never commit real values. Add these to the deployment environment / secret manager.

# Lead storage (already used by Malik AI)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback when Supabase is unavailable.
# Receives POST JSON with the lead payload.
BUSINESS_LEADS_WEBHOOK_URL=

# Telegram Business Bot
TELEGRAM_BUSINESS_BOT_TOKEN=
# 1-256 chars; letters, digits, underscore and hyphen work with Telegram setWebhook secret_token.
TELEGRAM_BUSINESS_WEBHOOK_SECRET=
# Public production origin, no trailing slash.
MALIK_PUBLIC_ORIGIN=https://malikaiworld.world

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set the Graph API version currently enabled for the Meta app, e.g. vXX.X.
WHATSAPP_GRAPH_VERSION=
