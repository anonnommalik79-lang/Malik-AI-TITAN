# Malik AI — Presentations (раздел «Презентации»)
#
# Everything works with none of these set: the numbers below are the defaults.
# Set them on Render only to change the limits.
#
# Cost: 1 credit for the plan + 1 credit per slide. A 10-slide deck = 11.
# Rewriting one slide = 1. PPTX and PDF downloads are free.
# Credits are reserved before the model runs and refunded if it fails, and a
# batch that returns fewer slides than asked is charged only for what arrived.
# Credits reset every day at 00:00 UTC. The owner account is unlimited.

# Daily credits per plan
PRESENTATION_GUEST_DAILY_CREDITS=0
PRESENTATION_FREE_DAILY_CREDITS=24
PRESENTATION_PRO_DAILY_CREDITS=240
PRESENTATION_ULTRA_DAILY_CREDITS=800

# Longest deck per plan (hard cap is 20)
PRESENTATION_FREE_MAX_SLIDES=12
PRESENTATION_PRO_MAX_SLIDES=20

# Where the daily counters are kept (private JSON in S3/R2). Optional: falls
# back to MUSIC_DAILY_GATE_BUCKET, then MEDIA_STORAGE_BUCKET and the usual
# S3/R2 credentials. Without any bucket the counters live in memory and reset
# when the server restarts.
# PRESENTATION_DAILY_GATE_BUCKET=

# ---------------------------------------------------------------- photos
# Slides get real photographs automatically, found by each slide's own search
# words. Searching is free for users (no credits).
#
# Without any key, photos come from Wikimedia Commons and Openverse — free
# licences for commercial use (CC0, public domain, CC BY, CC BY-SA); the
# photographer and licence are shown small on the slide, as the licence asks.
#
# For the best general "mood" photos (offices, food, cities, people), add a
# free key from one or both stock libraries:
#   https://www.pexels.com/api/            → PEXELS_API_KEY
#   https://unsplash.com/developers        → UNSPLASH_ACCESS_KEY
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=
#
# Turn a free source off with "off":
# PRESENTATION_PHOTOS_WIKIMEDIA=off
# PRESENTATION_PHOTOS_OPENVERSE=off
