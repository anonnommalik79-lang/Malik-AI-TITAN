  divider: "\u0438\u043b\u0438 \u0432\u043e\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437",
  guest: "\u0412\u043e\u0439\u0442\u0438 \u043a\u0430\u043a \u0433\u043e\u0441\u0442\u044c",
  badName: "\u0418\u043c\u044f \u043c\u0438\u043d\u0438\u043c\u0443\u043c 2 \u0441\u0438\u043c\u0432\u043e\u043b\u0430.",
  badEmail: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 email.",
  badPass: "\u041f\u0430\u0440\u043e\u043b\u044c \u043c\u0438\u043d\u0438\u043c\u0443\u043c 6 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432.",
  badRepeat: "\u041f\u0430\u0440\u043e\u043b\u0438 \u043d\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u044e\u0442.",
};

function read(ref: React.RefObject<HTMLInputElement | null>) {
  return ref.current?.value?.trim() || "";
}

function saveSession(provider: Provider, username = "Abdumalik", emailRaw = "guest@malik.ai") {
  if (typeof window === "undefined") return;

  const now = new Date().toISOString();
  const isGuest = provider === "guest";
  const email = (isGuest ? "guest@malik.ai" : emailRaw || `${provider}@malik.ai`).trim().toLowerCase();
  const name = isGuest ? "\u0413\u043e\u0441\u0442\u044c" : username || "Abdumalik";

  const user = {
    id: isGuest ? "guest-user" : email,
    uid: isGuest ? "guest-user" : email,
    name,
    username: name,
    email,
    provider,
    role: email === "amangeldymalik38@gmail.com" ? "admin" : "user",
    isAdmin: email === "amangeldymalik38@gmail.com",
    isGuest,
    authenticated: true,
    isAuthenticated: true,
    loggedIn: true,
    createdAt: now,
    lastLoginAt: now,
  };

  const session = {
    ok: true,
    user,
    email,
    name,
    mode: isGuest ? "guest" : provider === "email" ? "email" : "oauth",
    provider,
    authenticated: true,
    isAuthenticated: true,
    loggedIn: true,
    accessToken: isGuest ? "guest-local-access" : `${provider}-local-access`,
    refreshToken: isGuest ? "guest-local-refresh" : `${provider}-local-refresh`,
    createdAt: now,
    lastLoginAt: now,
  };

  const userJson = JSON.stringify(user);
  const sessionJson = JSON.stringify(session);

  const pairs: Array<[string, string]> = [
    ["malik_auth_mode", provider],
    ["malik_user_name", name],
    ["malik_user_email", email],
    ["malik_user", userJson],
    ["malik_session", sessionJson],
    ["malik_auth_snapshot", sessionJson],
    ["malik_ai_session", sessionJson],
    ["malik_is_authenticated", "true"],
    ["malik_guest_unlocked", isGuest ? "true" : "false"],
    ["sovereign_session", sessionJson],
    ["sovereign_v7_auth", sessionJson],
    ["sovereign_authenticated", "true"],
    ["auth_session", sessionJson],
    ["isAuthenticated", "true"],
    ["authenticated", "true"],
  ];

  for (const [key, value] of pairs) {
    try {
      localStorage.setItem(key, value);
      sessionStorage.setItem(key, value);
    } catch {}
  }
}

function startOAuth(provider: Exclude<Provider, "email" | "guest">) {
  if (typeof window === "undefined") return;

  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
  const supabaseProvider = provider === "microsoft" ? "azure" : provider;

  if (supabaseUrl && supabaseUrl.includes("supabase.co")) {
    window.location.href =
      `${supabaseUrl.replace(/\/+$/, "")}/auth/v1/authorize?provider=${encodeURIComponent(supabaseProvider)}` +
      `&redirect_to=${encodeURIComponent(window.location.origin + "/dashboard")}`;
    return;
  }

  saveSession(provider, "Abdumalik", `${provider}@malik.ai`);
  window.location.href = "/dashboard";
}

function ProviderIcon({ type }: { type: Provider }) {
  if (type === "google") return <span style={{ color: "#4285F4" }}>G</span>;
  if (type === "github") return <span>в—Џ</span>;
  if (type === "apple") return <span>в—Џ</span>;
  if (type === "microsoft") return <span style={{ color: "#00A4EF" }}>в– </span>;
  return null;
}

export function SovereignVideoAuth() {
  const usernameRef = useRef<HTMLInputElement>(null);
  const emailRef = useRef<HTMLInputElement>(null);
  const passwordRef = useRef<HTMLInputElement>(null);
  const confirmRef = useRef<HTMLInputElement>(null);

  const [isOpening, setIsOpening] = useState(false);
  const [message, setMessage] = useState("");
  const [iconFailed, setIconFailed] = useState(false);
  const [bgFailed, setBgFailed] = useState(false);

  const openGuest = useCallback(() => {
    if (isOpening) return;
    setIsOpening(true);
    saveSession("guest", "\u0413\u043e\u0441\u0442\u044c", "guest@malik.ai");
    window.location.href = "/dashboard";
  }, [isOpening]);

  const submit = useCallback((event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    const username = read(usernameRef);
    const email = read(emailRef).toLowerCase();
    const password = read(passwordRef);
    const confirm = read(confirmRef);

    if (username.length < 2) return setMessage(T.badName);
    if (!email.includes("@") || !email.includes(".")) return setMessage(T.badEmail);
    if (password.length < 6) return setMessage(T.badPass);
    if (password !== confirm) return setMessage(T.badRepeat);

    setIsOpening(true);
    saveSession("email", username, email);
    window.location.href = "/dashboard";
  }, []);

  return (
    <main className="sva-root">
      <img className="sva-bg" src={IMAGE_SRC} alt="" draggable={false} onError={() => setBgFailed(true)} />
      {bgFailed && <div className="sva-bg-fallback" />}

      <div className="sva-left-shadow" />
      <div className="sva-top-clear" />
      <div className="sva-dragon-aura" />
      <div className="sva-wind sva-wind-a" />
      <div className="sva-wind sva-wind-b" />

      <section className="sva-card">
        <div className="sva-card-aura" />
        <div className="sva-card-line" />

        <header className="sva-brand">
          <div className="sva-logo">
            {!iconFailed ? (
              <img src={ICON_SRC} alt="" draggable={false} onError={() => setIconFailed(true)} />
            ) : (
              <span />
            )}
          </div>

          <div>
            <p className="sva-brand-title">Sovereign Hub</p>
            <p className="sva-brand-sub">MALIK AI В· V6.5 TITAN</p>
          </div>
        </header>

        <div className="sva-hero">
          <span className="sva-pill">{T.pill}</span>
          <h1 className="sva-h1">{T.title}</h1>
          <p className="sva-tagline">{T.tagline}</p>
        </div>

        <form className="sva-form" onSubmit={submit}>
          <label className="sva-field" htmlFor="sva-username">
            <span>{T.username}</span>
            <input id="sva-username" ref={usernameRef} defaultValue="Abdumalik" autoComplete="username" />
          </label>

          <label className="sva-field" htmlFor="sva-email">
            <span>Email</span>
            <input id="sva-email" ref={emailRef} type="email" placeholder="name@domain.com" autoComplete="email" />
          </label>

          <div className="sva-duo">
            <label className="sva-field" htmlFor="sva-password">
              <span>{T.password}</span>
              <input id="sva-password" ref={passwordRef} type="password" placeholder={T.passPh} autoComplete="new-password" />
            </label>

            <label className="sva-field" htmlFor="sva-confirm">
              <span>{T.repeat}</span>
              <input id="sva-confirm" ref={confirmRef} type="password" placeholder={T.repeatPh} autoComplete="new-password" />
            </label>
          </div>

          <button className="sva-cta" type="submit" disabled={isOpening}>
            <span>{isOpening ? T.opening : T.cont}</span>
            <em>{"в†’"}</em>
          </button>

          <div className="sva-divider">
            <i />
            <small>{T.divider}</small>
            <i />
          </div>

          <div className="sva-socials">
            <button type="button" onClick={() => startOAuth("google")} disabled={isOpening}><ProviderIcon type="google" /> Google</button>
            <button type="button" onClick={() => startOAuth("github")} disabled={isOpening}><ProviderIcon type="github" /> GitHub</button>
            <button type="button" onClick={() => startOAuth("apple")} disabled={isOpening}><ProviderIcon type="apple" /> Apple</button>
            <button type="button" onClick={() => startOAuth("microsoft")} disabled={isOpening}><ProviderIcon type="microsoft" /> Microsoft</button>
          </div>

          <button className="sva-guest" type="button" onClick={openGuest} disabled={isOpening}>
            {T.guest}
          </button>

          {message && <p className="sva-message">{message}</p>}
        </form>
      </section>

      <style>{styles}</style>
    </main>
  );
}

