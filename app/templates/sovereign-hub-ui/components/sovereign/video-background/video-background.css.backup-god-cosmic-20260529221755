/* MALIK AI вЂ” ONE-SHOT NASA CANVAS BACKGROUND */

.malik-force-video-root,
.malik-welcome-video-host {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;
  background: #000107 !important;
}

.malik-video-bg,
.malik-nasa-canvas-bg {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  min-width: 100vw !important;
  min-height: 100vh !important;
  z-index: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
  background: #000107 !important;
}

.malik-nasa-canvas {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  display: block !important;
  background: #000107 !important;
}

.malik-nasa-noise {
  position: fixed !important;
  inset: 0 !important;
  opacity: 0.055 !important;
  mix-blend-mode: screen !important;
  background-image:
    radial-gradient(circle at 18% 22%, rgba(255,255,255,.55) 0 1px, transparent 1px),
    radial-gradient(circle at 72% 41%, rgba(120,220,255,.38) 0 1px, transparent 1px),
    radial-gradient(circle at 43% 76%, rgba(200,120,255,.34) 0 1px, transparent 1px);
  background-size: 120px 120px, 170px 170px, 230px 230px;
  animation: malikNasaNoiseDrift 34s linear infinite;
}

.malik-nasa-readability {
  position: fixed !important;
  inset: 0 !important;
  background:
    linear-gradient(180deg, rgba(0, 2, 10, 0.20), rgba(0, 2, 10, 0.04) 42%, rgba(0, 2, 10, 0.30)),
    radial-gradient(circle at 50% 34%, rgba(34, 91, 255, 0.035), transparent 44%) !important;
}

.malik-nasa-vignette {
  position: fixed !important;
  inset: 0 !important;
  background:
    radial-gradient(circle at 50% 48%, transparent 0%, transparent 66%, rgba(0, 0, 0, 0.35) 100%),
    linear-gradient(90deg, rgba(0,0,0,.18), transparent 22%, transparent 78%, rgba(0,0,0,.18)) !important;
}

.malik-force-video-root .malik-space-x,
.malik-force-video-root .malik-animated-space,
.malik-force-video-root .malik-welcome-earth-bg,
.malik-force-video-root .malik-space-bg,
.malik-welcome-video-host .malik-space-x,
.malik-welcome-video-host .malik-animated-space,
.malik-welcome-video-host .malik-welcome-earth-bg,
.malik-welcome-video-host .malik-space-bg {
  display: none !important;
  opacity: 0 !important;
}

.malik-force-video-root > :not(.malik-video-bg),
.malik-welcome-video-host > :not(.malik-video-bg) {
  position: relative !important;
  z-index: 5 !important;
}

@keyframes malikNasaNoiseDrift {
  from {
    background-position: 0 0, 0 0, 0 0;
  }
  to {
    background-position: 260px 180px, -210px 240px, 180px -260px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .malik-nasa-noise {
    animation: none !important;
  }
}