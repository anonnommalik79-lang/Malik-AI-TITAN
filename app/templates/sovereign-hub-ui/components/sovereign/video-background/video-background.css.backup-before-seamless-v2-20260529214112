/* MALIK AI вЂ” HQ FULLSCREEN VIDEO BACKGROUND */

.malik-force-video-root,
.malik-welcome-video-host {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;
  background: #000107 !important;
}

.malik-video-bg {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  min-width: 100vw !important;
  min-height: 100vh !important;
  z-index: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
  background: #000107 !important;
}

/* Quality fix:
   - opacity 1
   - less destructive filter
   - no aggressive scale
   - cover fills full dashboard
*/
.malik-video-bg__video {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  min-width: 100vw !important;
  min-height: 100vh !important;
  object-fit: cover !important;
  object-position: center center !important;
  opacity: 1 !important;
  filter: saturate(1.04) contrast(1.03) brightness(0.88) !important;
  transform: scale(1.003) !important;
  backface-visibility: hidden !important;
  will-change: auto !important;
}

.malik-video-bg__overlay,
.malik-video-bg__cinema {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background:
    radial-gradient(circle at 50% 35%, rgba(65,120,255,.06), transparent 42%),
    radial-gradient(circle at 72% 20%, rgba(168,85,247,.08), transparent 30%),
    linear-gradient(180deg, rgba(0,2,10,.28), rgba(0,2,10,.04) 44%, rgba(0,2,10,.38)) !important;
}

.malik-video-bg__depth {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background:
    radial-gradient(circle at 50% 72%, rgba(76,151,255,.08), transparent 50%),
    linear-gradient(90deg, rgba(0,0,0,.18), transparent 30%, transparent 70%, rgba(0,0,0,.18)) !important;
}

.malik-video-bg__vignette {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background:
    radial-gradient(circle at 50% 48%, transparent 0%, transparent 58%, rgba(0,0,0,.42) 100%),
    linear-gradient(90deg, rgba(0,0,0,.22), transparent 28%, transparent 72%, rgba(0,0,0,.22)) !important;
}

.malik-force-video-root .malik-space-x,
.malik-force-video-root .malik-animated-space,
.malik-force-video-root .malik-welcome-earth-bg,
.malik-force-video-root .malik-space-bg,
.malik-welcome-video-host .malik-space-x,
.malik-welcome-video-host .malik-animated-space,
.malik-welcome-video-host .malik-welcome-earth-bg,
.malik-welcome-video-host .malik-space-bg {
  display: none !important;
  opacity: 0 !important;
}

.malik-force-video-root > :not(.malik-video-bg),
.malik-welcome-video-host > :not(.malik-video-bg) {
  position: relative !important;
  z-index: 5 !important;
}

@media (prefers-reduced-motion: reduce) {
  .malik-video-bg__video {
    display: none !important;
  }

  .malik-video-bg {
    background-image: url("/backgrounds/space-poster.jpg") !important;
    background-size: cover !important;
    background-position: center center !important;
  }
}