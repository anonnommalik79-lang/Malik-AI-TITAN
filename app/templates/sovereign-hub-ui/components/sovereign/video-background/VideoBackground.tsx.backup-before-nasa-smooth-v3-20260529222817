"use client";

import { useEffect, useRef } from "react";
import "./video-background.css";

type Star = {
  x: number;
  y: number;
  r: number;
  speedX: number;
  speedY: number;
  twinkle: number;
  hue: number;
  alpha: number;
  depth: number;
};

type Meteor = {
  x: number;
  y: number;
  vx: number;
  vy: number;
  length: number;
  width: number;
  age: number;
  life: number;
  colorA: string;
  colorB: string;
};

type OrbitalNode = {
  radiusX: number;
  radiusY: number;
  angle: number;
  speed: number;
  size: number;
  alpha: number;
};

type Asteroid = {
  baseX: number;
  baseY: number;
  size: number;
  drift: number;
  rotation: number;
  rotationSpeed: number;
  alpha: number;
  wobble: number;
};

function rand(min: number, max: number) {
  return min + Math.random() * (max - min);
}

function clamp(v: number, min: number, max: number) {
  return Math.max(min, Math.min(max, v));
}

function createPaletteHue() {
  const variants = [190, 205, 220, 245, 260, 278];
  return variants[Math.floor(Math.random() * variants.length)];
}

export default function VideoBackground() {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const rafRef = useRef<number | null>(null);
  const starsRef = useRef<Star[]>([]);
  const meteorsRef = useRef<Meteor[]>([]);
  const nodesRef = useRef<OrbitalNode[]>([]);
  const asteroidsRef = useRef<Asteroid[]>([]);
  const lastTimeRef = useRef<number>(0);
  const meteorCooldownRef = useRef<number>(0);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", {
      alpha: false,
      desynchronized: true,
    });

    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    const createStars = () => {
      const count = clamp(Math.floor((width * height) / 1900), 420, 1200);
      starsRef.current = Array.from({ length: count }, () => {
        const depth = Math.random();
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          r: rand(0.4, 1.9) * (0.5 + depth * 0.8),
          speedX: rand(0.002, 0.045) * (0.5 + depth),
          speedY: rand(0.0005, 0.012) * (0.5 + depth),
          twinkle: rand(0, Math.PI * 2),
          hue: createPaletteHue(),
          alpha: rand(0.18, 0.92),
          depth,
        };
      });
    };

    const createNodes = () => {
      nodesRef.current = Array.from({ length: 8 }, (_, i) => ({
        radiusX: width * rand(0.22, 0.42),
        radiusY: height * rand(0.08, 0.22),
        angle: rand(0, Math.PI * 2),
        speed: rand(0.00008, 0.00022) * (i % 2 === 0 ? 1 : -1),
        size: rand(2.2, 5.8),
        alpha: rand(0.25, 0.72),
      }));
    };

    const createAsteroids = () => {
      asteroidsRef.current = [
        { baseX: width * 0.10, baseY: height * 0.74, size: width * 0.030, drift: 0.00008, rotation: 0.1, rotationSpeed: 0.00008, alpha: 0.32, wobble: 18 },
        { baseX: width * 0.17, baseY: height * 0.89, size: width * 0.018, drift: -0.00011, rotation: 1.5, rotationSpeed: -0.00013, alpha: 0.24, wobble: 11 },
        { baseX: width * 0.87, baseY: height * 0.67, size: width * 0.021, drift: 0.00012, rotation: 2.1, rotationSpeed: 0.00010, alpha: 0.24, wobble: 15 },
        { baseX: width * 0.92, baseY: height * 0.77, size: width * 0.011, drift: -0.00010, rotation: 0.6, rotationSpeed: -0.00014, alpha: 0.18, wobble: 13 },
        { baseX: width * 0.06, baseY: height * 0.31, size: width * 0.014, drift: 0.00009, rotation: 0.3, rotationSpeed: 0.00010, alpha: 0.14, wobble: 12 },
      ];
    };

    const resize = () => {
      dpr = clamp(window.devicePixelRatio || 1, 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      createStars();
      createNodes();
      createAsteroids();
    };

    const spawnMeteor = () => {
      const fromLeft = Math.random() > 0.35;
      const x = fromLeft ? rand(-width * 0.18, width * 0.40) : rand(width * 0.58, width * 1.06);
      const y = rand(-height * 0.10, height * 0.30);
      const speed = rand(520, 1050);
      const angle = fromLeft ? rand(0.28, 0.60) : rand(2.38, 2.72);

      meteorsRef.current.push({
        x,
        y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        length: rand(100, 280),
        width: rand(1.1, 2.6),
        age: 0,
        life: rand(0.85, 1.55),
        colorA: Math.random() > 0.52 ? "rgba(122,223,255," : "rgba(202,132,255,",
        colorB: "rgba(255,255,255,",
      });
    };

    const drawSpaceBase = (t: number) => {
      const bg = ctx.createLinearGradient(0, 0, width, height);
      bg.addColorStop(0, "#02040c");
      bg.addColorStop(0.22, "#06112a");
      bg.addColorStop(0.52, "#07081d");
      bg.addColorStop(1, "#010207");
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, width, height);

      const nebulaLeft = ctx.createRadialGradient(width * 0.18, height * 0.46, 0, width * 0.18, height * 0.46, width * 0.56);
      nebulaLeft.addColorStop(0, "rgba(45,132,255,0.22)");
      nebulaLeft.addColorStop(0.28, "rgba(122,72,255,0.17)");
      nebulaLeft.addColorStop(0.56, "rgba(186,84,255,0.08)");
      nebulaLeft.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = nebulaLeft;
      ctx.fillRect(0, 0, width, height);

      const nebulaRight = ctx.createRadialGradient(width * 0.88, height * 0.18, 0, width * 0.88, height * 0.18, width * 0.52);
      nebulaRight.addColorStop(0, "rgba(112,91,255,0.18)");
      nebulaRight.addColorStop(0.32, "rgba(58,163,255,0.14)");
      nebulaRight.addColorStop(0.62, "rgba(76,43,201,0.08)");
      nebulaRight.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = nebulaRight;
      ctx.fillRect(0, 0, width, height);

      const pulse = 0.5 + Math.sin(t * 0.00028) * 0.5;
      const core = ctx.createRadialGradient(width * 0.52, height * 0.35, 0, width * 0.52, height * 0.35, width * 0.55);
      core.addColorStop(0, `rgba(64,118,255,${0.06 + pulse * 0.03})`);
      core.addColorStop(0.40, "rgba(82,56,255,0.05)");
      core.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = core;
      ctx.fillRect(0, 0, width, height);
    };

    const drawDistantPlanets = (t: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";

      const p1x = width * 0.80;
      const p1y = height * 0.28 + Math.sin(t * 0.00018) * 6;
      const p1r = Math.min(width, height) * 0.040;
      const planet1 = ctx.createRadialGradient(p1x - p1r * 0.2, p1y - p1r * 0.2, 0, p1x, p1y, p1r);
      planet1.addColorStop(0, "rgba(119,136,171,0.45)");
      planet1.addColorStop(0.62, "rgba(57,70,106,0.32)");
      planet1.addColorStop(1, "rgba(12,16,28,0.04)");
      ctx.fillStyle = planet1;
      ctx.beginPath();
      ctx.arc(p1x, p1y, p1r, 0, Math.PI * 2);
      ctx.fill();

      const p2x = width * 0.24;
      const p2y = height * 0.48 + Math.cos(t * 0.00022) * 7;
      const p2r = Math.min(width, height) * 0.055;
      const planet2 = ctx.createRadialGradient(p2x - p2r * 0.3, p2y - p2r * 0.2, 0, p2x, p2y, p2r);
      planet2.addColorStop(0, "rgba(140,180,255,0.26)");
      planet2.addColorStop(0.52, "rgba(52,70,136,0.19)");
      planet2.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = planet2;
      ctx.beginPath();
      ctx.arc(p2x, p2y, p2r, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    };

    const drawStars = (delta: number, t: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";

      for (const star of starsRef.current) {
        star.x += star.speedX * delta * (0.5 + star.depth);
        star.y += star.speedY * delta * (0.4 + star.depth);

        if (star.x > width + 8) star.x = -8;
        if (star.y > height + 8) star.y = -8;

        const tw = 0.55 + Math.sin(t * 0.0015 + star.twinkle) * 0.45;
        const alpha = clamp(star.alpha * (0.45 + tw * 0.8), 0.06, 1);

        ctx.fillStyle = `hsla(${star.hue}, 100%, ${78 + star.depth * 18}%, ${alpha})`;
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);
        ctx.fill();

        if (star.depth > 0.8) {
          ctx.fillStyle = `hsla(${star.hue}, 100%, 82%, ${alpha * 0.18})`;
          ctx.fillRect(star.x - star.r * 3.5, star.y, star.r * 7, 0.9);
          ctx.fillRect(star.x, star.y - star.r * 3.5, 0.9, star.r * 7);
        }
      }

      ctx.restore();
    };

    const drawOrbitSystem = (t: number) => {
      const cx = width * 0.52;
      const cy = height * 0.67;

      ctx.save();
      ctx.globalCompositeOperation = "screen";

      for (let i = 0; i < 4; i++) {
        ctx.beginPath();
        ctx.ellipse(
          cx,
          cy + i * 8,
          width * (0.26 + i * 0.08),
          height * (0.075 + i * 0.015),
          -0.04 + i * 0.01,
          0,
          Math.PI * 2
        );
        ctx.strokeStyle = `rgba(96, 134, 255, ${0.03 + i * 0.012})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      nodesRef.current.forEach((node, index) => {
        node.angle += node.speed * 16;
        const x = cx + Math.cos(node.angle + index * 0.3) * node.radiusX;
        const y = cy + Math.sin(node.angle) * node.radiusY;

        const glow = ctx.createRadialGradient(x, y, 0, x, y, node.size * 4);
        glow.addColorStop(0, `rgba(134, 215, 255, ${node.alpha})`);
        glow.addColorStop(0.35, `rgba(126, 96, 255, ${node.alpha * 0.46})`);
        glow.addColorStop(1, "rgba(0,0,0,0)");

        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(x, y, node.size * 4, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = `rgba(220,245,255,${node.alpha})`;
        ctx.beginPath();
        ctx.arc(x, y, node.size, 0, Math.PI * 2);
        ctx.fill();
      });

      ctx.restore();
    };

    const drawAsteroidShape = (x: number, y: number, size: number, rotation: number, alpha: number) => {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.beginPath();
      ctx.moveTo(-size * 0.9, -size * 0.15);
      ctx.lineTo(-size * 0.35, -size * 0.92);
      ctx.lineTo(size * 0.42, -size * 0.72);
      ctx.lineTo(size * 0.98, -size * 0.12);
      ctx.lineTo(size * 0.72, size * 0.62);
      ctx.lineTo(-size * 0.12, size * 0.94);
      ctx.lineTo(-size * 0.86, size * 0.42);
      ctx.closePath();

      const grad = ctx.createLinearGradient(-size, -size, size, size);
      grad.addColorStop(0, `rgba(150, 163, 188, ${alpha})`);
      grad.addColorStop(0.35, `rgba(78, 86, 111, ${alpha * 0.95})`);
      grad.addColorStop(1, `rgba(28, 32, 43, ${alpha * 0.78})`);
      ctx.fillStyle = grad;
      ctx.shadowColor = `rgba(116,146,255,${alpha * 0.12})`;
      ctx.shadowBlur = 10;
      ctx.fill();

      ctx.fillStyle = `rgba(238, 244, 255, ${alpha * 0.10})`;
      ctx.beginPath();
      ctx.arc(-size * 0.16, -size * 0.10, size * 0.18, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    };

    const drawAsteroids = (t: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "source-over";

      asteroidsRef.current.forEach((asteroid) => {
        const x = asteroid.baseX + Math.sin(t * asteroid.drift * 1000) * asteroid.wobble;
        const y = asteroid.baseY + Math.cos(t * asteroid.drift * 800) * (asteroid.wobble * 0.35);
        asteroid.rotation += asteroid.rotationSpeed * 16;
        drawAsteroidShape(x, y, asteroid.size, asteroid.rotation, asteroid.alpha);
      });

      ctx.restore();
    };

    const drawMeteors = (delta: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";

      meteorsRef.current = meteorsRef.current.filter((m) => {
        m.age += delta / 1000;
        m.x += m.vx * (delta / 1000);
        m.y += m.vy * (delta / 1000);

        const progress = m.age / m.life;
        const fade = Math.sin(clamp(progress, 0, 1) * Math.PI);

        const tailX = m.x - (m.vx / Math.hypot(m.vx, m.vy)) * m.length;
        const tailY = m.y - (m.vy / Math.hypot(m.vx, m.vy)) * m.length;

        const grad = ctx.createLinearGradient(m.x, m.y, tailX, tailY);
        grad.addColorStop(0, `${m.colorB}${0.95 * fade})`);
        grad.addColorStop(0.16, `${m.colorA}${0.65 * fade})`);
        grad.addColorStop(1, `${m.colorA}0)`);

        ctx.strokeStyle = grad;
        ctx.lineWidth = m.width;
        ctx.shadowColor = "rgba(160, 208, 255, 0.55)";
        ctx.shadowBlur = 14;

        ctx.beginPath();
        ctx.moveTo(m.x, m.y);
        ctx.lineTo(tailX, tailY);
        ctx.stroke();

        return progress < 1.0 && m.x > -500 && m.x < width + 500 && m.y < height + 500;
      });

      ctx.restore();
    };

    const drawLightArcs = (t: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";

      const travel = (t * 0.008) % (width * 1.4);

      for (let i = 0; i < 5; i++) {
        const y = height * (0.18 + i * 0.12);
        ctx.beginPath();
        ctx.moveTo(-width * 0.2 + travel * (0.18 + i * 0.03), y + i * 8);
        ctx.quadraticCurveTo(width * 0.46, y - height * (0.08 + i * 0.01), width * 1.18, y + height * 0.05);
        ctx.strokeStyle = `rgba(118, 155, 255, ${0.035 + i * 0.008})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      const beam = ctx.createLinearGradient(width * 0.74, 0, width, height * 0.65);
      beam.addColorStop(0, "rgba(213, 128, 255, 0.18)");
      beam.addColorStop(0.28, "rgba(114, 113, 255, 0.08)");
      beam.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = beam;
      ctx.fillRect(width * 0.60, 0, width * 0.40, height * 0.50);

      ctx.restore();
    };

    const drawHorizon = (t: number) => {
      const cx = width * 0.52;
      const cy = height * 1.13;
      const rx = width * 0.66;
      const ry = height * 0.34;
      const pulse = 0.5 + Math.sin(t * 0.00035) * 0.5;

      ctx.save();
      ctx.globalCompositeOperation = "screen";

      const glow = ctx.createRadialGradient(cx, height * 0.96, 0, cx, height * 0.96, width * 0.62);
      glow.addColorStop(0, `rgba(64, 155, 255, ${0.18 + pulse * 0.06})`);
      glow.addColorStop(0.28, "rgba(114, 93, 255, 0.09)");
      glow.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, Math.PI, Math.PI * 2);
      ctx.strokeStyle = `rgba(173, 224, 255, ${0.40 + pulse * 0.14})`;
      ctx.lineWidth = 1.4;
      ctx.shadowColor = "rgba(64, 155, 255, 0.85)";
      ctx.shadowBlur = 20;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(cx, cy + 22, rx * 1.04, ry * 1.03, 0, Math.PI, Math.PI * 2);
      ctx.strokeStyle = "rgba(152, 96, 255, 0.18)";
      ctx.lineWidth = 1;
      ctx.shadowBlur = 32;
      ctx.stroke();

      ctx.restore();
    };

    const draw = (t: number) => {
      const last = lastTimeRef.current || t;
      const delta = clamp(t - last, 0, 42);
      lastTimeRef.current = t;

      meteorCooldownRef.current += delta;
      if (meteorCooldownRef.current > rand(900, 1800)) {
        meteorCooldownRef.current = 0;
        spawnMeteor();
        if (Math.random() > 0.72) spawnMeteor();
      }

      drawSpaceBase(t);
      drawLightArcs(t);
      drawDistantPlanets(t);
      drawStars(delta, t);
      drawOrbitSystem(t);
      drawAsteroids(t);
      drawMeteors(delta);
      drawHorizon(t);

      rafRef.current = window.requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener("resize", resize);
    rafRef.current = window.requestAnimationFrame(draw);

    return () => {
      window.removeEventListener("resize", resize);
      if (rafRef.current !== null) {
        window.cancelAnimationFrame(rafRef.current);
      }
    };
  }, []);

  return (
    <div className="malik-video-bg malik-cosmic-god-bg" aria-hidden="true">
      <canvas ref={canvasRef} className="malik-cosmic-god-canvas" />
      <div className="malik-cosmic-noise" />
      <div className="malik-cosmic-scanlines" />
      <div className="malik-cosmic-readability" />
      <div className="malik-cosmic-vignette" />
    </div>
  );
}