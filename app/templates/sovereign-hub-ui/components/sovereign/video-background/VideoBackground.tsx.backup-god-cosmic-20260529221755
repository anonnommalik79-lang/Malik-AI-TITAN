"use client";

import { useEffect, useRef } from "react";
import "./video-background.css";

type Star = {
  x: number;
  y: number;
  z: number;
  r: number;
  twinkle: number;
  drift: number;
  color: string;
};

type Meteor = {
  x: number;
  y: number;
  length: number;
  speed: number;
  angle: number;
  life: number;
  maxLife: number;
  width: number;
  color: string;
};

const COLORS = ["#ffffff", "#b8d7ff", "#7fd8ff", "#d9c3ff", "#8d5cff"];

function rand(min: number, max: number) {
  return min + Math.random() * (max - min);
}

function clamp(value: number, min: number, max: number) {
  return Math.max(min, Math.min(max, value));
}

export default function VideoBackground() {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const rafRef = useRef<number | null>(null);
  const starsRef = useRef<Star[]>([]);
  const meteorsRef = useRef<Meteor[]>([]);
  const lastTimeRef = useRef<number>(0);
  const meteorTimerRef = useRef<number>(0);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", {
      alpha: false,
      desynchronized: true,
    });

    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    const createStars = () => {
      const count = clamp(Math.floor((width * height) / 2300), 360, 980);

      starsRef.current = Array.from({ length: count }, () => {
        const depth = Math.random();

        return {
          x: Math.random() * width,
          y: Math.random() * height,
          z: depth,
          r: rand(0.45, 1.9) * (0.45 + depth),
          twinkle: rand(0, Math.PI * 2),
          drift: rand(0.015, 0.085) * (0.25 + depth),
          color: COLORS[Math.floor(Math.random() * COLORS.length)],
        };
      });
    };

    const resize = () => {
      dpr = clamp(window.devicePixelRatio || 1, 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      createStars();
    };

    const spawnMeteor = () => {
      const fromTop = Math.random() > 0.38;

      meteorsRef.current.push({
        x: fromTop ? rand(width * 0.12, width * 0.92) : rand(width * 0.72, width * 1.08),
        y: fromTop ? rand(-height * 0.10, height * 0.22) : rand(height * 0.06, height * 0.56),
        length: rand(130, 310),
        speed: rand(520, 980),
        angle: rand(Math.PI * 0.63, Math.PI * 0.78),
        life: 0,
        maxLife: rand(0.78, 1.45),
        width: rand(1.0, 2.4),
        color: Math.random() > 0.55 ? "rgba(125, 220, 255," : "rgba(188, 125, 255,",
      });
    };

    const drawBackground = (time: number) => {
      const deep = ctx.createLinearGradient(0, 0, width, height);
      deep.addColorStop(0, "#02040c");
      deep.addColorStop(0.32, "#061022");
      deep.addColorStop(0.56, "#08071d");
      deep.addColorStop(1, "#000107");
      ctx.fillStyle = deep;
      ctx.fillRect(0, 0, width, height);

      const nebulaLeft = ctx.createRadialGradient(
        width * 0.18,
        height * 0.45,
        0,
        width * 0.18,
        height * 0.45,
        width * 0.58
      );
      nebulaLeft.addColorStop(0, "rgba(57, 168, 255, 0.20)");
      nebulaLeft.addColorStop(0.25, "rgba(115, 63, 255, 0.16)");
      nebulaLeft.addColorStop(0.48, "rgba(184, 56, 255, 0.08)");
      nebulaLeft.addColorStop(1, "rgba(0, 0, 0, 0)");
      ctx.fillStyle = nebulaLeft;
      ctx.fillRect(0, 0, width, height);

      const nebulaRight = ctx.createRadialGradient(
        width * 0.87,
        height * 0.28,
        0,
        width * 0.87,
        height * 0.28,
        width * 0.50
      );
      nebulaRight.addColorStop(0, "rgba(95, 130, 255, 0.16)");
      nebulaRight.addColorStop(0.36, "rgba(143, 64, 255, 0.12)");
      nebulaRight.addColorStop(0.66, "rgba(24, 220, 255, 0.05)");
      nebulaRight.addColorStop(1, "rgba(0, 0, 0, 0)");
      ctx.fillStyle = nebulaRight;
      ctx.fillRect(0, 0, width, height);

      const slowPulse = 0.5 + Math.sin(time * 0.00035) * 0.5;
      const centralBlue = ctx.createRadialGradient(
        width * 0.50,
        height * 0.36,
        0,
        width * 0.50,
        height * 0.36,
        width * 0.62
      );
      centralBlue.addColorStop(0, `rgba(34, 110, 255, ${0.06 + slowPulse * 0.025})`);
      centralBlue.addColorStop(0.44, "rgba(20, 45, 145, 0.045)");
      centralBlue.addColorStop(1, "rgba(0, 0, 0, 0)");
      ctx.fillStyle = centralBlue;
      ctx.fillRect(0, 0, width, height);
    };

    const drawPlanetHorizon = (time: number) => {
      const pulse = 0.6 + Math.sin(time * 0.00042) * 0.4;
      const cx = width * 0.52;
      const cy = height * 1.13;
      const rx = width * 0.62;
      const ry = height * 0.33;

      ctx.save();
      ctx.globalCompositeOperation = "screen";

      const glow = ctx.createRadialGradient(cx, height * 0.94, 0, cx, height * 0.94, width * 0.62);
      glow.addColorStop(0, `rgba(54, 145, 255, ${0.18 + pulse * 0.05})`);
      glow.addColorStop(0.35, "rgba(86, 75, 255, 0.08)");
      glow.addColorStop(1, "rgba(0,0,0,0)");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, Math.PI, Math.PI * 2);
      ctx.strokeStyle = `rgba(142, 205, 255, ${0.45 + pulse * 0.10})`;
      ctx.lineWidth = 1.3;
      ctx.shadowColor = "rgba(77, 166, 255, 0.75)";
      ctx.shadowBlur = 18;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(cx, cy + 20, rx * 1.05, ry * 1.03, 0, Math.PI, Math.PI * 2);
      ctx.strokeStyle = "rgba(117, 84, 255, 0.18)";
      ctx.lineWidth = 1;
      ctx.shadowBlur = 34;
      ctx.stroke();

      ctx.restore();
    };

    const drawStars = (delta: number, time: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";

      for (const star of starsRef.current) {
        star.x += star.drift * delta * 0.045 * (0.4 + star.z);
        star.y += star.drift * delta * 0.012 * (0.2 + star.z);

        if (star.x > width + 8) star.x = -8;
        if (star.y > height + 8) star.y = -8;

        const alpha = 0.18 + star.z * 0.72 + Math.sin(time * 0.002 + star.twinkle) * 0.12;
        ctx.beginPath();
        ctx.fillStyle = star.color.replace("#", "rgba(");
        ctx.globalAlpha = clamp(alpha, 0.08, 0.96);

        const rgb =
          star.color === "#ffffff"
            ? "255,255,255"
            : star.color === "#b8d7ff"
              ? "184,215,255"
              : star.color === "#7fd8ff"
                ? "127,216,255"
                : star.color === "#d9c3ff"
                  ? "217,195,255"
                  : "141,92,255";

        ctx.fillStyle = `rgba(${rgb},${clamp(alpha, 0.08, 0.96)})`;
        ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);
        ctx.fill();

        if (star.z > 0.82) {
          ctx.globalAlpha = alpha * 0.18;
          ctx.fillRect(star.x - star.r * 3, star.y, star.r * 6, 0.7);
          ctx.fillRect(star.x, star.y - star.r * 3, 0.7, star.r * 6);
        }
      }

      ctx.globalAlpha = 1;
      ctx.restore();
    };

    const drawMeteors = (delta: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";

      meteorsRef.current = meteorsRef.current.filter((meteor) => {
        meteor.life += delta / 1000;

        const progress = meteor.life / meteor.maxLife;
        meteor.x += Math.cos(meteor.angle) * meteor.speed * (delta / 1000);
        meteor.y += Math.sin(meteor.angle) * meteor.speed * (delta / 1000);

        const fade = Math.sin(clamp(progress, 0, 1) * Math.PI);
        const tailX = meteor.x - Math.cos(meteor.angle) * meteor.length;
        const tailY = meteor.y - Math.sin(meteor.angle) * meteor.length;

        const grad = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
        grad.addColorStop(0, `${meteor.color}${0.72 * fade})`);
        grad.addColorStop(0.18, `${meteor.color}${0.32 * fade})`);
        grad.addColorStop(1, `${meteor.color}0)`);

        ctx.strokeStyle = grad;
        ctx.lineWidth = meteor.width;
        ctx.shadowColor = meteor.color.includes("125") ? "rgba(125, 220, 255, 0.8)" : "rgba(188, 125, 255, 0.8)";
        ctx.shadowBlur = 12;

        ctx.beginPath();
        ctx.moveTo(meteor.x, meteor.y);
        ctx.lineTo(tailX, tailY);
        ctx.stroke();

        ctx.shadowBlur = 0;
        return progress < 1 && meteor.x > -500 && meteor.y < height + 500;
      });

      ctx.restore();
    };

    const drawSatelliteLines = (time: number) => {
      ctx.save();
      ctx.globalCompositeOperation = "screen";
      ctx.strokeStyle = "rgba(92, 158, 255, 0.075)";
      ctx.lineWidth = 1;

      const offset = (time * 0.006) % width;

      for (let i = 0; i < 4; i++) {
        const y = height * (0.22 + i * 0.13);
        ctx.beginPath();
        ctx.moveTo(-width * 0.2 + offset * (0.4 + i * 0.08), y + i * 20);
        ctx.quadraticCurveTo(width * 0.45, y - height * 0.14, width * 1.2, y + height * 0.08);
        ctx.stroke();
      }

      ctx.restore();
    };

    const draw = (time: number) => {
      const last = lastTimeRef.current || time;
      const delta = clamp(time - last, 0, 42);
      lastTimeRef.current = time;

      meteorTimerRef.current += delta;
      if (meteorTimerRef.current > rand(850, 1900)) {
        meteorTimerRef.current = 0;
        spawnMeteor();
        if (Math.random() > 0.68) spawnMeteor();
      }

      drawBackground(time);
      drawSatelliteLines(time);
      drawStars(delta, time);
      drawMeteors(delta);
      drawPlanetHorizon(time);

      rafRef.current = window.requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener("resize", resize);
    rafRef.current = window.requestAnimationFrame(draw);

    return () => {
      window.removeEventListener("resize", resize);
      if (rafRef.current !== null) {
        window.cancelAnimationFrame(rafRef.current);
      }
    };
  }, []);

  return (
    <div className="malik-video-bg malik-nasa-canvas-bg" aria-hidden="true">
      <canvas ref={canvasRef} className="malik-nasa-canvas" />
      <div className="malik-nasa-noise" />
      <div className="malik-nasa-readability" />
      <div className="malik-nasa-vignette" />
    </div>
  );
}