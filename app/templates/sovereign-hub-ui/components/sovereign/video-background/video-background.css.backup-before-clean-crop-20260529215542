/* MALIK AI вЂ” LEGENDARY SEAMLESS HQ VIDEO BACKGROUND V2 */

.malik-force-video-root,
.malik-welcome-video-host {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;
  background: #000107 !important;
}

.malik-video-bg {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  min-width: 100vw !important;
  min-height: 100vh !important;
  z-index: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
  background: #000107 !important;
}

.malik-video-bg__video {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  min-width: 100vw !important;
  min-height: 100vh !important;
  object-fit: cover !important;
  object-position: center center !important;
  opacity: 1 !important;
  filter: none !important;
  transform: none !important;
  image-rendering: auto !important;
  backface-visibility: hidden !important;
  will-change: auto !important;
}

.malik-video-bg__readability {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background:
    linear-gradient(180deg, rgba(0, 2, 10, 0.10), rgba(0, 2, 10, 0.02) 45%, rgba(0, 2, 10, 0.18)),
    radial-gradient(circle at 50% 34%, rgba(34, 91, 255, 0.025), transparent 45%) !important;
}

.malik-video-bg__vignette {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background:
    radial-gradient(circle at 50% 48%, transparent 0%, transparent 68%, rgba(0, 0, 0, 0.18) 100%),
    linear-gradient(90deg, rgba(0,0,0,.08), transparent 22%, transparent 78%, rgba(0,0,0,.08)) !important;
}

.malik-force-video-root .malik-space-x,
.malik-force-video-root .malik-animated-space,
.malik-force-video-root .malik-welcome-earth-bg,
.malik-force-video-root .malik-space-bg,
.malik-welcome-video-host .malik-space-x,
.malik-welcome-video-host .malik-animated-space,
.malik-welcome-video-host .malik-welcome-earth-bg,
.malik-welcome-video-host .malik-space-bg {
  display: none !important;
  opacity: 0 !important;
}

.malik-force-video-root > :not(.malik-video-bg),
.malik-welcome-video-host > :not(.malik-video-bg) {
  position: relative !important;
  z-index: 5 !important;
}

@media (prefers-reduced-motion: reduce) {
  .malik-video-bg__video {
    display: none !important;
  }

  .malik-video-bg {
    background-image: url("/backgrounds/space-poster.jpg") !important;
    background-size: cover !important;
    background-position: center center !important;
  }
}