function sovereignWriteAuthSession(provider: "guest" | "google" | "github" | "apple" | "microsoft" | "email" = "guest") {
  if (typeof window === "undefined") return;

  const now = new Date().toISOString();
  const isGuest = provider === "guest";
  const email = isGuest ? "guest@malik.ai" : `${provider}@malik.ai`;
  const name = isGuest ? "�����" : provider;

  const user = {
    id: isGuest ? "guest-user" : email,
    uid: isGuest ? "guest-user" : email,
    name,
    username: name,
    email,
    avatar: "",
    provider,
    role: "user",
    isAdmin: false,
    isGuest,
    authenticated: true,
    loggedIn: true,
    createdAt: now,
    lastLoginAt: now,
  };

  const session = {
    ok: true,
    user,
    mode: isGuest ? "guest" : "oauth",
    provider,
    authenticated: true,
    isAuthenticated: true,
    loggedIn: true,
    accessToken: isGuest ? "guest-local-access" : "oauth-local-access",
    refreshToken: isGuest ? "guest-local-refresh" : "oauth-local-refresh",
    createdAt: now,
    lastLoginAt: now,
  };

  const userJson = JSON.stringify(user);
  const sessionJson = JSON.stringify(session);

  const entries: Array<[string, string]> = [
    ["malik_auth_mode", provider],
    ["malik_user_name", name],
    ["malik_user_email", email],
    ["malik_user_avatar", ""],
    ["malik_last_login_at", now],
    ["malik_user", userJson],
    ["malik_session", sessionJson],
    ["malik_auth_snapshot", sessionJson],
    ["malik_ai_user", userJson],
    ["malik_ai_session", sessionJson],
    ["malik_is_authenticated", "true"],
    ["malik_guest_unlocked", isGuest ? "true" : "false"],
    ["sovereign_user", userJson],
    ["sovereign_session", sessionJson],
    ["sovereign_auth_user", userJson],
    ["sovereign_auth_session", sessionJson],
    ["sovereign_v7_auth", sessionJson],
    ["sovereign_authenticated", "true"],
    ["auth_user", userJson],
    ["auth_session", sessionJson],
    ["isAuthenticated", "true"],
    ["authenticated", "true"],
  ];

  for (const [key, value] of entries) {
    try {
      window.localStorage.setItem(key, value);
      window.sessionStorage.setItem(key, value);
    } catch {
      // ignore storage errors
    }
  }

  try {
    document.cookie = `malik_auth_mode=${encodeURIComponent(provider)}; path=/; max-age=2592000; SameSite=Lax`;
    document.cookie = `malik_guest_unlocked=${isGuest ? "true" : "false"}; path=/; max-age=2592000; SameSite=Lax`;
    document.cookie = "sovereign_authenticated=true; path=/; max-age=2592000; SameSite=Lax";
  } catch {
    // ignore cookie errors
  }

  try {
    window.dispatchEvent(new StorageEvent("storage", { key: "malik_user", newValue: userJson }));
    window.dispatchEvent(new CustomEvent("malik:auth", { detail: session }));
    window.dispatchEvent(new CustomEvent("sovereign:auth", { detail: session }));
    window.dispatchEvent(new CustomEvent("malik-auth-updated", { detail: session }));
  } catch {
    // ignore event errors
  }
}

function sovereignStartOAuth(provider: "google" | "github" | "apple" | "microsoft") {
  if (typeof window === "undefined") return;

  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
  const redirectTo = window.location.origin;
  const supabaseProvider = provider === "microsoft" ? "azure" : provider;

  if (supabaseUrl && supabaseUrl.includes("supabase.co")) {
    const url =
      `${supabaseUrl}/auth/v1/authorize?provider=${encodeURIComponent(supabaseProvider)}` +
      `&redirect_to=${encodeURIComponent(redirectTo)}`;

    window.location.href = url;
    return;
  }

  alert(
    `${provider.toUpperCase()} OAuth ?��� .env.local ������ NEXT_PUBLIC_SUPABASE_URL �?�� NEXT_PUBLIC_SUPABASE_ANON_KEY �����. ` +
      `?��� demo-session �������.`
  );

  sovereignWriteAuthSession(provider);
  window.location.href = "/dashboard";
}

function sovereignDetectButtonProvider(text: string): "guest" | "google" | "github" | "apple" | "microsoft" | "email" | null {
  const value = text.toLowerCase();

  if (value.includes("�����") || value.includes("guest")) return "guest";
  if (value.includes("google")) return "google";
  if (value.includes("github")) return "github";
  if (value.includes("apple")) return "apple";
  if (value.includes("microsoft")) return "microsoft";
  if (value.includes("����������") || value.includes("�����") || value.includes("sign") || value.includes("continue")) return "email";

  return null;
}


function safeSetItem(key: string, value: string) {
  try {
    if (typeof window !== "undefined") window.localStorage.setItem(key, value);
  } catch {
    // localStorage can be blocked; continue without crashing.
  }
}

function getValue(ref: React.RefObject<HTMLInputElement | null>) {
  return ref.current?.value?.trim() || "";
}

function normalizeEmail(value: string) {
  return value.trim().toLowerCase();
}

function isAdminEmail(email: string) {
  return normalizeEmail(email) === "amangeldymalik38@gmail.com";
}

