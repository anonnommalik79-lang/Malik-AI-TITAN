function createDashboardRuntimeId(prefix = "dash"): string {
  try {
    if (isBrowser() && window.crypto?.randomUUID) {
      return `${prefix}-${window.crypto.randomUUID()}`
    }
  } catch {}
  return `${prefix}-${Date.now()}-${Math.random().toString(16).slice(2)}`
}

function safeJsonParse<T>(raw: string, fallback: T): T {
  try {
    if (!raw) return fallback
    const parsed = JSON.parse(raw)
    return parsed as T
  } catch {
    return fallback
  }
}

function checksumText(input: string): string {
  let hash = 0
  const text = input || ""
  for (let i = 0; i < text.length; i += 1) {
    hash = ((hash << 5) - hash + text.charCodeAt(i)) | 0
  }
  return Math.abs(hash).toString(16)
}

function normalizeDashboardViewId(view: string | null | undefined): string {
  const raw = String(view || "home").trim()
  if (!raw) return "home"
  if (DASHBOARD_VIEW_REGISTRY[raw]) return raw
  const lower = raw.toLowerCase().replace(/\s+/g, "-")
  if (DASHBOARD_VIEW_REGISTRY[lower]) return lower
  const byKeyword = DASHBOARD_SAFE_VIEW_IDS.find((id) =>
    DASHBOARD_VIEW_REGISTRY[id].keywords.some((keyword) => lower.includes(keyword.toLowerCase()))
  )
  return byKeyword || "home"
}

function getDashboardViewMeta(view: string): DashboardViewRegistryEntry {
  return DASHBOARD_VIEW_REGISTRY[normalizeDashboardViewId(view)] || DASHBOARD_VIEW_REGISTRY.home
}

function inferDashboardResponseKind(prompt: string, mode: AiModeId = "auto"): DashboardResponseKind {
  const t = `${mode} ${prompt || ""}`.toLowerCase()
  if (/website|landing|dashboard|canvas|preview|html|tsx|react|component|ui|сайт|лендинг|дашборд|интерфейс|шаблон/.test(t)) return "canvas"
  if (/code|код|debug|ошиб|typescript|javascript|python|sql|api|refactor|архитект/.test(t)) return "code"
  return "chat"
}

function detectIntentAndRoute(
  prompt: string,
  attachments: ChatAttachment[] = [],
  mode: AiModeId = "auto"
): DashboardRouteDecision {
  const raw = String(prompt || "")
  const t = `${mode} ${raw}`.toLowerCase()
  const explicitRoute = /^(open|go to|show|открой|перейди|покажи|запусти)\b/.test(t)
  const responseKind = inferDashboardResponseKind(raw, mode)
  const generationKind = detectDashboardGenerationKind(raw, attachments, mode)
  const candidates = DASHBOARD_SAFE_VIEW_IDS
    .map((id) => {
      const meta = DASHBOARD_VIEW_REGISTRY[id]
      const matchedKeywords = meta.keywords.filter((keyword) => t.includes(keyword.toLowerCase()))
      const score =
        matchedKeywords.length * 10 +
        (t.includes(id) ? 16 : 0) +
        (meta.opensPreview && responseKind === "canvas" ? 4 : 0)
      return { id, score, matchedKeywords }
    })
    .sort((a, b) => b.score - a.score)

  const best = candidates[0]
  const matchedKeywords = best?.matchedKeywords || []

  if (/\bcodex\b|кодекс|cursor|папк|файл проекта/.test(t)) {
    return {
      action: "open-codex",
      targetView: "home",
      responseKind,
      generationKind,
      confidence: 0.91,
      reason: "Codex/project-folder intent detected.",
      matchedKeywords: ["codex"],
      shouldRouteBeforeSend: explicitRoute,
    }
  }

  if (/canvas|preview|превью|открой холст|канвас/.test(t)) {
    return {
      action: "open-canvas",
      targetView: "home",
      responseKind: "canvas",
      generationKind,
      confidence: 0.88,
      reason: "Canvas/preview intent detected.",
      matchedKeywords: ["canvas", "preview"],
      shouldRouteBeforeSend: explicitRoute,
    }
  }

  if (best && best.score >= 10 && normalizeDashboardViewId(best.id) !== "home") {
    return {
      action: "open-view",
      targetView: best.id,
      responseKind,
      generationKind,
      confidence: Math.min(0.97, 0.55 + best.score / 100),
      reason: `Matched view registry: ${DASHBOARD_VIEW_REGISTRY[best.id].title}`,
      matchedKeywords,
      shouldRouteBeforeSend: explicitRoute,
    }
  }

  return {
    action: "send",
    targetView: "home",
    responseKind,
    generationKind,
    confidence: responseKind === "chat" ? 0.72 : 0.82,
    reason: "No direct view switch required; keep the chat flow.",
    matchedKeywords,
    shouldRouteBeforeSend: false,
  }
}

function mobileStateMachine(input: MobileMachineInput): MobileMachineOutput {
  const safeView = normalizeDashboardViewId(input.activeView)
  const meta = getDashboardViewMeta(safeView)
  const width = isBrowser() ? window.innerWidth : 1440
  const desktop = width >= DASHBOARD_SAFE_RENDER_LIMITS.mobileBreakpoint

  if (desktop) {
    return {
      phase: "desktop",
      title: meta.title,
      canGoBack: false,
      shouldTrapScroll: false,
      shouldShowOverlay: false,
      safeView,
    }
  }

  if (input.codexOpen) {
    return {
      phase: "mobile-codex",
      title: "Codex",
      canGoBack: true,
      shouldTrapScroll: true,
      shouldShowOverlay: true,
      safeView,
    }
  }

  if (input.mobilePreviewOpen) {
    return {
      phase: "mobile-preview",
      title: "Preview",
      canGoBack: true,
      shouldTrapScroll: true,
      shouldShowOverlay: true,
      safeView,
    }
  }

  if (input.mobileMenuOpen) {
    return {
      phase: "mobile-menu",
      title: "Menu",
      canGoBack: true,
      shouldTrapScroll: true,
      shouldShowOverlay: true,
      safeView,
    }
  }

  if (safeView !== "home") {
    return {
      phase: "mobile-view",
      title: meta.title,
      canGoBack: true,
      shouldTrapScroll: false,
      shouldShowOverlay: false,
      safeView,
    }
  }

  return {
    phase: "mobile-home",
    title: "Malik AI",
    canGoBack: false,
    shouldTrapScroll: false,
    shouldShowOverlay: false,
    safeView,
  }
}

class SovereignDashboardEventBus {
  private handlers = new Set<DashboardEventHandler>()
  private memory: DashboardEvent[] = []

  on(handler: DashboardEventHandler): () => void {
    this.handlers.add(handler)
    return () => this.handlers.delete(handler)
  }

  emit(event: Omit<DashboardEvent, "id" | "at"> & { id?: string; at?: string }): DashboardEvent {
    const safeEvent: DashboardEvent = {
      id: event.id || createDashboardRuntimeId("event"),
      at: event.at || new Date().toISOString(),
      type: event.type,
      source: event.source || "dashboard",
      view: event.view,
      payload: event.payload,
    }
    this.memory = [safeEvent, ...this.memory].slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxEventMemory)
    this.handlers.forEach((handler) => {
      try {
        handler(safeEvent)
      } catch (error) {
        console.warn("[DASHBOARD EVENT HANDLER ERROR]", error)
      }
    })
    return safeEvent
  }

