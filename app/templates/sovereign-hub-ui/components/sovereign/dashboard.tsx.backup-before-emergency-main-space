        <div className={layout === "grid" ? "grid gap-5 md:grid-cols-2 xl:grid-cols-3" : "space-y-3"}>
          {filtered.map((chat) => (
            <button
              key={chat.id}
              onClick={() => onSelectProject(chat.id)}
              className={cn(
                "w-full rounded-[2rem] border border-white/10 bg-white/[0.03] p-5 text-left transition hover:border-violet-500/40 hover:bg-white/[0.06]",
                layout === "list" && "flex items-center justify-between gap-6",
              )}
            >
              <div>
                <div className="flex items-center gap-3">
                  <span className={cn(
                    "rounded-full px-3 py-1 text-xs font-black",
                    chat.status === "deployed" && "bg-emerald-500/10 text-emerald-300",
                    chat.status === "building" && "bg-amber-500/10 text-amber-300",
                    chat.status === "draft" && "bg-white/10 text-gray-300",
                  )}>
                    {chat.status || "draft"}
                  </span>
                  {chat.isPinned && <Star className="h-4 w-4 text-amber-300" />}
                </div>
                <h3 className="mt-4 text-xl font-black text-white">{chat.title}</h3>
                <p className="mt-2 text-sm text-gray-500">{formatDate(chat.timestamp)}</p>
                <div className="mt-4 flex flex-wrap gap-2">
                  {chat.techStack?.map((tech) => (
                    <span key={tech} className="rounded-full bg-white/10 px-2 py-1 text-xs text-gray-300">{tech}</span>
                  ))}
                </div>
              </div>
              {layout === "list" && <ArrowRight className="h-5 w-5 text-gray-500" />}
            </button>
          ))}
        </div>
      </div>
    </div>
  )
}

