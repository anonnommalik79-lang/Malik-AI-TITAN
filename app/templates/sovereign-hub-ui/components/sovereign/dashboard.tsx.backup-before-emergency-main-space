  if (typeof parsed === "string") return parsed
  return parsed.content ?? parsed.text ?? parsed.message ?? parsed.response ?? parsed.delta ?? null
}

const handleSendMessage = useCallback(async (content: string, attachments: ChatAttachment[] = []) => {
  const cleanContent = (content || "").trim()
  if (!cleanContent || isLoading) return

  const routeDecision = detectIntentAndRoute(cleanContent, attachments, activeAiMode)
  dashboardEventBus.emit({
    type: "intent:routed",
    source: "handleSendMessage",
    view: activeViewRef.current,
    payload: routeDecision,
  })

  if (routeDecision.shouldRouteBeforeSend && routeDecision.action === "open-view") {
    safeOpenView(routeDecision.targetView, "intent")
  } else if (routeDecision.shouldRouteBeforeSend && routeDecision.action === "open-codex") {
    setCodexOpen(true)
  }

  const runtimePlan = buildSovereignRuntimePlan(cleanContent, attachments, activeAiMode)
  const mode = runtimePlan.responseMode
  const isProjReq = runtimePlan.isProjectRequest
  const isCodeReq = mode === "code"
  // MALIK_CHAT_PREVIEW_CLOSE_V3
  if (!isProjReq) {
    setIsGeneratingTerminal(false)
    setMobilePreviewOpen(false)
    setGeneratedCode("")
  }
  const inlineMediaKind = detectInlineMediaGenerationRequest(cleanContent, attachments, activeAiMode)
  setActiveGenerationKind(inlineMediaKind || detectDashboardGenerationKind(cleanContent, attachments, activeAiMode))
  const chatId = activeChatId || crypto.randomUUID()
  const title = cleanContent.slice(0, 34) + (cleanContent.length > 34 ? "..." : "")

  if (!activeChatId) {
    const newChat: Chat = {
      id: chatId,
      title,
      timestamp: new Date(),
      messages: [],
      status: runtimePlan.status,
      techStack: runtimePlan.techStack
    }
    setChats(prev => [newChat, ...prev])
    setActiveChatId(chatId)
  } else {
    setChats(prev => prev.map(c => c.id === chatId ? { ...c, status: runtimePlan.status, techStack: runtimePlan.techStack } : c))
  }

  const userMessage: Message = {
    id: crypto.randomUUID(),
    role: "user",
    content: cleanContent,
    timestamp: new Date(),
  }

  const assistantMessage: Message = {
    id: crypto.randomUUID(),
    role: "assistant",
    content: inlineMediaKind ? buildInlineMediaAssistantText(createInlineMediaSeed(inlineMediaKind, cleanContent)) : "",
    timestamp: new Date(),
    isStreaming: true,
    intentType: inlineMediaKind ? "chat" : isProjReq ? "project" : "chat",
    generatedMedia: inlineMediaKind ? createInlineMediaSeed(inlineMediaKind, cleanContent) : undefined,
  }

  setMessages(prev => [...prev, userMessage, assistantMessage])
  setIsLoading(true)
  dashboardEventBus.emit({
    type: "chat:send",
    source: "handleSendMessage",
    view: activeViewRef.current,
    payload: { chatId, mode, routeDecision },
  })
  setStreamingText("")
  setErrorNotification(null)
  if (isProjReq) {
    setIsGeneratingTerminal(true)
    if (typeof window !== "undefined" && window.innerWidth < 1024) setMobilePreviewOpen(true)
  }

  const startTime = Date.now()
  const MIN_TERMINAL_TIME = isProjReq ? 6500 : 0
  const normalizedEmail = (username || "").trim().toLowerCase() || "guest@local"

  const history = [...messages, userMessage].slice(-12).map(m => ({
    role: m.role,
    content: m.content,
  }))

  const attachmentSummary = attachments.length
    ? "\n\n[Вложения]: " + attachments.map(a => `${a.kind}:${a.name || a.url || "untitled"} (${a.mime || "text"})`).join(", ")
    : ""

  const instruction = `${buildSovereignInstruction(mode, cleanContent + attachmentSummary)}\n\n${runtimePlan.instruction}`
  const question = `${cleanContent}\n\n${instruction}`

  const finalizeAssistant = (finalText: string, finalCode?: string) => {
    const hasProjectCode = Boolean(finalCode && finalCode.trim().split("\n").length >= 25)
    const openPreview = isProjReq && hasProjectCode
    const safeContent = openPreview
      ? "✨ Генерация проекта завершена. Результат открыт справа."
      : finalText || buildLocalChatAnswer(cleanContent, mode)

    setMessages(prev =>
      prev.map(m =>
        m.id === assistantMessage.id
          ? {
              ...m,
              content: safeContent,
              generatedCode: openPreview ? finalCode : undefined,
              isStreaming: false,
              intentType: openPreview ? "project" : "chat",
            }
          : m
      )
    )

    if (openPreview && finalCode) {
      saveGeneratedProjectSnapshot(cleanContent, finalCode, runtimePlan)
      setGeneratedCode(finalCode)
      setTotalVersions(prev => prev + 1)
      setCurrentVersion(prev => prev + 1)
    } else if (!isProjReq) {
      setIsGeneratingTerminal(false)
    }

    setChats(prev =>
      prev.map(c =>
        c.id === chatId
          ? {
              ...c,
              status: "draft",
              title: c.messages.length === 0 ? title : c.title,
              messages: [
                ...c.messages,
                userMessage,
                {
                  ...assistantMessage,
                  content: safeContent,
                  generatedCode: openPreview ? finalCode : undefined,
                  isStreaming: false,
                  intentType: openPreview ? "project" : "chat",
                },
              ],
            }
          : c
      )
    )
  }

  const finalizeInlineMedia = (media: InlineMediaGeneration) => {
    const finalAssistant = {
      ...assistantMessage,
      content: buildInlineMediaAssistantText(media),
      generatedMedia: media,
      isStreaming: false,
      intentType: "chat" as const,
    }

    setMessages(prev =>
      prev.map(m =>
        m.id === assistantMessage.id ? finalAssistant : m
      )
    )

    setChats(prev =>
      prev.map(c =>
        c.id === chatId
          ? {
              ...c,
              status: media.status === "ready" ? "deployed" : "draft",
              title: c.messages.length === 0 ? title : c.title,
              techStack: [media.provider || "Media API", media.kind === "video" ? "Video" : "Image", "Inline chat"],
              messages: [
                ...c.messages,
                userMessage,
                finalAssistant,
              ],
            }
          : c
      )
    )
  }

  const patchInlineMedia = (patch: Partial<InlineMediaGeneration>) => {
    setMessages(prev =>
      prev.map(m =>
        m.id === assistantMessage.id && m.generatedMedia
          ? {
              ...m,
              content: buildInlineMediaAssistantText({ ...m.generatedMedia, ...patch }),
              generatedMedia: { ...m.generatedMedia, ...patch },
            }
          : m
      )
    )
  }

  if (inlineMediaKind && assistantMessage.generatedMedia) {
    try {
      setIsGeneratingTerminal(false)
      patchInlineMedia({ status: "thinking", progress: 14 })
      await new Promise((resolve) => setTimeout(resolve, 350))
      patchInlineMedia({ status: "generating", progress: 36 })

      const mediaEndpoint = inlineMediaKind === "video" ? "/api/generate/video" : "/api/generate/photo"
      const response = await fetch(mediaEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          prompt: cleanContent,
          kind: inlineMediaKind === "video" ? "video" : "photo",
          provider: "luma",
          style: "cinematic Gemini-style transparent chat generation",
          aspectRatio: inlineMediaKind === "video" ? "16:9" : "1:1",
          format: inlineMediaKind === "video" ? "16:9" : "1:1",
          duration: inlineMediaKind === "video" ? 5 : undefined,
          userEmail: normalizedEmail,
          mediaProAccessCode: "Malik ai",
          attachments: attachments.map((item) => ({
            id: item.id,
            name: item.name,
            mime: item.mime,
            kind: item.kind,
            base64: item.base64,
            url: item.url,
          })),
        }),
      })

      patchInlineMedia({ status: "rendering", progress: 72 })
      const payload = await response.json().catch(() => ({}))

      if (!response.ok) {
        throw new Error(payload?.error || payload?.message || `Media API returned ${response.status}`)
      }

      const mediaUrl = extractInlineMediaUrl(payload, inlineMediaKind)
      if (!mediaUrl) {
        throw new Error("Media API finished, but no media URL was returned.")
      }

      const readyMedia: InlineMediaGeneration = {
        ...assistantMessage.generatedMedia,
        status: "ready",
        progress: 100,
        url: mediaUrl,
        thumbnailUrl: typeof payload?.thumbnailUrl === "string" ? payload.thumbnailUrl : typeof payload?.assets?.thumbnail === "string" ? payload.assets.thumbnail : undefined,
        provider: payload?.providerTitle || payload?.provider || assistantMessage.generatedMedia.provider,
      }

      finalizeInlineMedia(readyMedia)
    } catch (error) {
      const failedMedia: InlineMediaGeneration = {
        ...assistantMessage.generatedMedia,
        status: "failed",
        progress: 100,
        error: error instanceof Error ? error.message : "Unknown media generation error",
      }
      setErrorNotification(buildInlineMediaAssistantText(failedMedia))
      finalizeInlineMedia(failedMedia)
    } finally {
      setIsLoading(false)
      setStreamingText("")
    }
    return
  }


  try {
