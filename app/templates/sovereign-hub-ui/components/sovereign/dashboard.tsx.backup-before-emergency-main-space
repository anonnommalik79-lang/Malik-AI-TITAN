  // =========================================================================
  // FLAWLESS CHAT PARSER — only canvas projects become preview artifacts
  // =========================================================================
  const extractCodeBlocks = (
    text: string,
    mode: ResponseMode
  ): { text: string; code: string; lang: string } => {
    const ticks = String.fromCharCode(96).repeat(3)
    const codeBlockRegex = new RegExp(
      ticks + '(?:([a-zA-Z0-9_+\\-]*)\\s*)?\\n([\\s\\S]*?)' + ticks,
      'g'
    )
    const matches = [...String(text || "").matchAll(codeBlockRegex)]

    if (matches.length === 0) return { text: text || "", code: "", lang: "" }

    const biggest = matches.reduce((max, m) => {
      const bodyLen = (m[2] || "").length
      const maxLen = (max[2] || "").length
      return bodyLen > maxLen ? m : max
    }, matches[0])

    const code = biggest[2] || ""
    const lang = (biggest[1] || "").toLowerCase()
    const cleanText = String(text || "").replace(codeBlockRegex, "").trim()
    const lineCount = code.trim().split("\n").filter(Boolean).length
    const isLargeArtifact = code.length > 900 || lineCount >= 30

    // Important: normal chat/code explanations must stay in chat.
    // Preview opens ONLY for canvas/project requests with a serious artifact.
    if (mode === "canvas" && isLargeArtifact) {
      return {
        text: cleanText || "✨ Интерфейс успешно сгенерирован",
        code,
        lang,
      }
    }

    return {
      text: cleanText || text || "",
