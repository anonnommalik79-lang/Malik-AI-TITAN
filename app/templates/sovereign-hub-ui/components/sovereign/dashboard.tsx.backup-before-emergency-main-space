  const [layout, setLayout] = useState<"grid" | "list">("grid")
  const [query, setQuery] = useState("")

  const filtered = chats.filter((chat) =>
    `${chat.title} ${chat.status} ${chat.techStack?.join(" ")}`.toLowerCase().includes(query.toLowerCase()),
  )

  return (
    <div className="flex-1 h-full overflow-y-auto bg-[#030303] p-8">
      <div className="mx-auto max-w-7xl">
        <div className="mb-8 flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
          <div>
            <h1 className="text-5xl font-black text-white">Projects</h1>
            <p className="mt-2 text-gray-500">Cursor-like local project history: chats, artifacts, statuses.</p>
          </div>
          <button
            onClick={onNewProject}
            className="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3 font-black text-black"
          >
            <Plus className="h-4 w-4" /> New Project
          </button>
        </div>

        <div className="mb-8 grid gap-4 md:grid-cols-4">
          {[
            ["Total", stats.total],
            ["Deployed", stats.deployed],
            ["Building", stats.building],
            ["Draft", stats.draft],
          ].map(([label, value]) => (
            <div key={label} className="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
              <p className="text-sm text-gray-500">{label}</p>
              <p className="mt-2 text-3xl font-black text-white">{value}</p>
            </div>
          ))}
        </div>

        <div className="mb-6 flex gap-3">
          <div className="relative flex-1">
            <Search className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500" />
            <input
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search projects..."
              className="w-full rounded-2xl border border-white/10 bg-black py-4 pl-11 pr-4 text-white outline-none focus:border-violet-500"
            />
          </div>
          <button onClick={() => setLayout(layout === "grid" ? "list" : "grid")} className="rounded-2xl border border-white/10 px-5 text-gray-300 hover:bg-white/5">
            {layout === "grid" ? <List className="h-5 w-5" /> : <LayoutGrid className="h-5 w-5" />}
          </button>
