  const filtered = MALIK_200_TEMPLATE_LIBRARY.filter((item) => {
    const q = query.toLowerCase()
    const okCategory = category === "all" || item.category === category
    const okText = !q || `${item.title} ${item.category} ${item.description} ${item.prompt}`.toLowerCase().includes(q)
    const okTab =
      tab === "community" ||
      (tab === "core" && ["Sovereign V8", "Billing", "Storage", "Workers"].includes(item.category)) ||
      (tab === "rescue" && item.category === "Qazaq Rescue AI") ||
      (tab === "dev" && ["Auto Dev", "Projects", "UI/UX"].includes(item.category))
    return okCategory && okText && okTab
  })

  return (
    <div className="flex-1 h-full overflow-y-auto bg-[#030303] custom-scrollbar">
      <div className="sticky top-0 z-20 border-b border-[#1F2937]/60 bg-[#030303]/85 px-8 py-5 backdrop-blur-2xl">
        <div className="flex flex-wrap items-center gap-4">
          {(["community", "core", "rescue", "dev"] as const).map((item) => (
            <button
              key={item}
              onClick={() => setTab(item)}
              className={cn(
                "rounded-2xl px-4 py-2 text-sm font-bold transition",
                tab === item ? "bg-white text-black" : "border border-white/10 text-gray-400 hover:bg-white/5 hover:text-white",
              )}
            >
              {item === "community" ? "Community" : item === "core" ? "Core SaaS" : item === "rescue" ? "Qazaq Rescue" : "Auto Dev"}
            </button>
          ))}

          <div className="ml-auto flex min-w-[360px] items-center gap-3">
            <div className="relative flex-1">
              <Search className="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500" />
              <input
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Search 200 features templates..."
                className="w-full rounded-2xl border border-white/10 bg-black py-3 pl-11 pr-4 text-sm outline-none focus:border-violet-500"
              />
            </div>
            <select
              value={category}
              onChange={(e) => setCategory(e.target.value)}
              className="rounded-2xl border border-white/10 bg-black px-4 py-3 text-sm outline-none focus:border-violet-500"
            >
              <option value="all">All</option>
              {categories.map((cat) => (
                <option key={cat} value={cat}>{cat}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <div className="mx-auto max-w-7xl px-8 py-10">
        <div className="mb-10">
          <div className="inline-flex rounded-full border border-violet-500/20 bg-violet-500/10 px-4 py-2 text-sm font-bold text-violet-200">
            Malik AI Template Market
          </div>
          <h1 className="mt-5 text-5xl font-black text-white">200 Features Templates</h1>
          <p className="mt-3 max-w-3xl text-gray-500">
            Бұл бөлім 200 фичаның UI/Dev/Rescue/SaaS бағыттарын шаблон ретінде қосады.
            Әр карточка prompt-ты canvas generation-ға жібереді.
          </p>
        </div>

        <div className="mb-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {[
            ["Total templates", MALIK_200_TEMPLATE_LIBRARY.length, LayoutTemplate],
            ["Categories", categories.length, Filter],
            ["Core modules", MALIK_CONNECTED_MODULES.length, Cpu],
            ["Safe mode", "ON", ShieldCheck],
          ].map(([label, value, Icon]: any) => (
            <div key={label} className="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
              <Icon className="h-6 w-6 text-violet-300" />
              <p className="mt-4 text-2xl font-black text-white">{value}</p>
              <p className="text-sm text-gray-500">{label}</p>
            </div>
          ))}
        </div>

        <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {filtered.map((template) => (
            <div
              key={template.id}
              className="group rounded-[2rem] border border-white/10 bg-white/[0.035] p-5 transition hover:-translate-y-1 hover:border-violet-500/40 hover:bg-violet-500/10"
            >
              <div className="flex items-center justify-between">
                <span className="rounded-full bg-white/10 px-3 py-1 text-xs font-black text-gray-300">{template.badge}</span>
                <span className="text-xs text-gray-500">{template.id}</span>
              </div>
              <h3 className="mt-5 min-h-[58px] text-xl font-black text-white">{template.title}</h3>
              <p className="mt-2 text-sm font-bold text-violet-300">{template.category}</p>
              <p className="mt-3 min-h-[72px] text-sm leading-6 text-gray-500">{template.description}</p>
              <div className="mt-5 flex items-center gap-4 text-xs text-gray-500">
                <span className="inline-flex items-center gap-1"><Eye className="h-3 w-3" />{template.views}</span>
                <span className="inline-flex items-center gap-1"><Heart className="h-3 w-3" />{template.likes}</span>
              </div>
              <button
                onClick={() => onUseTemplate(template.prompt)}
                className="mt-5 flex w-full items-center justify-center gap-2 rounded-2xl bg-white py-3 font-black text-black transition hover:bg-gray-200"
              >
                Use Template <ArrowRight className="h-4 w-4" />
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

function ProjectsView({
