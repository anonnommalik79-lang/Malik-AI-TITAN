type ResponseMode = "chat" | "code" | "canvas"


const detectResponseMode = (text: string): ResponseMode => {
  const t = (text || "").toLowerCase().trim()
  if (!t) return "chat"

  // SYSTEM COMMANDS: никогда не открывать canvas/preview
  // Эти команды должны идти как обычный чат в backend/ai_model.py
  if (
    t.startsWith("/admin_db") ||
    t.startsWith("/admin") ||
    t.startsWith("/stats")
  ) {
    return "chat"
  }

  const strongCanvas = [
    /\bсайт\b/, /\bлендинг\b/, /\blanding\b/, /\blanding page\b/,
    /\bстраниц(?:а|у|ы|е)\b/, /\bинтерфейс\b/, /\bui\b/,
    /\bdashboard\b/, /\bдашборд\b/,
    /\breact компонент\b/, /\bкомпонент\b/,
    /\bhtml\b/, /\bcss\b/, /\bверстк/, /\bсверстай\b/,
    /\bweb app\b/, /\bwebsite\b/, /\bfrontend\b/,
    /\bcreate website\b/, /\bbuild website\b/, /\bgenerate ui\b/, /\bcreate component\b/
  ]

  const codeWords = [
    "python", "javascript", "typescript", "sql", "функц", "скрипт", "пример кода",
    "ошибка", "debug", "refactor", "js", "ts"
  ]

  const createWords = ["создай", "сделай", "сгенерируй", "построй", "собери", "build", "generate", "create", "make"]
  const canvasWords = [
    "сайт", "лендинг", "страница", "интерфейс", "шаблон", "дашборд", "компонент", "код",
    "website", "site", "landing", "dashboard", "ui", "react", "tsx", "html", "component",
    "template", "canvas", "preview", "app", "saas",
  ]

  if (createWords.some((word) => t.includes(word)) && canvasWords.some((word) => t.includes(word))) return "canvas"
  if (["canvas", "preview", "website", "landing", "dashboard", "template", "react", "tsx", "html"].some((word) => t.includes(word))) return "canvas"
  if (strongCanvas.some((r) => r.test(t))) return "canvas"
  if (codeWords.some((w) => t.includes(w))) return "code"
  return "chat"
}

type SovereignRuntimePlan = {
  responseMode: ResponseMode
  isProjectRequest: boolean
  status: Chat["status"]
  techStack: string[]
  instruction: string
  canvasReason: string
}

const buildSovereignRuntimePlan = (
  prompt: string,
  attachments: ChatAttachment[],
  activeMode: AiModeId,
): SovereignRuntimePlan => {
  const detectedMode = detectResponseMode(prompt)
  const lower = (prompt || "").toLowerCase()
  const attachmentKinds = new Set(attachments.map((item) => item.kind))

  const canvasModes: AiModeId[] = ["website", "canvas", "presentation", "pdf", "word", "creator"]
  const codeModes: AiModeId[] = ["code", "architect", "debug", "data", "security", "research", "deep"]
  const directCanvasSignal =
    detectedMode === "canvas" ||
    canvasModes.includes(activeMode) ||
    /website|landing|dashboard|template|canvas|preview|html|tsx|react|component|ui|saas/.test(lower)

  const directCodeSignal =
    detectedMode === "code" ||
    codeModes.includes(activeMode) ||
    /debug|error|exception|typescript|javascript|python|sql|refactor|architecture|file tree|api route/.test(lower)

  const responseMode: ResponseMode = directCanvasSignal ? "canvas" : directCodeSignal ? "code" : "chat"
  const hasMedia = attachmentKinds.has("image") || attachmentKinds.has("video") || attachmentKinds.has("audio")
  const hasFiles = attachmentKinds.has("file") || attachmentKinds.has("code") || attachmentKinds.has("url")
  const isProjectRequest = responseMode === "canvas"

  const techStack = isProjectRequest
    ? ["Next.js", "React", "Tailwind", "Canvas", "Safe fallback"]
    : responseMode === "code"
      ? ["Code", "Debug", "Architecture", "Safe patch"]
      : hasMedia
        ? ["Multimodal", "Analysis", "Fallback"]
        : hasFiles
          ? ["Files", "Reader", "Summary"]
          : ["Chat", "AI", "Sovereign"]

  const modeRules: Record<AiModeId, string> = {
    auto: "Auto Route Mode: choose chat, code, canvas, Codex or media flow based on the request.",
    chat: "Chat Mode: answer in the conversation, do not open canvas unless the user clearly asks for a build artifact.",
    code: "Code Mode: return exact files, code blocks, checks, and minimal safe patch steps.",
    website: "Website Mode: return one complete preview artifact suitable for the right canvas.",
    image: "Image Mode: if image data exists, analyze visual details; if generating, describe prompt, style, size, and safe fallback.",
    video: "Video Mode: analyze timeline, frames, motion intent, or generate storyboard and render plan.",
    research: "Research Mode: structure answer as findings, assumptions, sources needed, and next checks.",
    agent: "Agent Mode: create task plan, progress steps, risks, and completion criteria.",
    architect: "Architect Mode: create module map, file tree, contracts, data flow, and rollout plan.",
    debug: "Debug Mode: format as bug report, suspected cause, exact fix, test command, and residual risk.",
    canvas: "Canvas Mode: return a full HTML/React preview artifact and keep it canvas-ready.",
    presentation: "Presentation Mode: create slide outline, speaker notes, and visual section plan.",
    pdf: "PDF Mode: create report sections, headings, tables, and export-ready structure.",
    word: "Word Mode: create editable document outline with sections and copy.",
    data: "Data Mode: parse data, find patterns, produce tables and clear interpretation.",
    security: "Security Defensive Mode: defensive-only, owned systems only, checklist and mitigation style.",
    "qazaq-rescue": "Qazaq Rescue Mode: emergency safety plans, offline instructions, family/school checklists.",
    fast: "Fast Mode: concise answer with direct next action.",
    deep: "Deep Mode: detailed reasoning, tradeoffs, checks, and implementation plan.",
    creator: "Creator Mode: premium brand, launch, design, and product storytelling output.",
  }

  const attachmentRules = [
    attachmentKinds.has("image") ? "Image attachment present: say that the image is being studied and include visual observations." : "",
    attachmentKinds.has("video") ? "Video attachment present: say that video frames/timeline are being analyzed." : "",
    attachmentKinds.has("audio") ? "Audio attachment present: say that voice/audio is being listened to and summarized." : "",
    hasFiles ? "File/code/url attachment present: parse it first, then answer from the attached context." : "",
  ].filter(Boolean)

  return {
    responseMode,
    isProjectRequest,
    status: isProjectRequest ? "building" : "draft",
    techStack,
    canvasReason: isProjectRequest ? "Creative/build request detected, open right canvas on desktop." : "Normal chat/code flow.",
    instruction: [
      "[MALIK_SOVEREIGN_DASHBOARD_KERNEL_V2]",
      modeRules[activeMode],
      `Detected response mode: ${responseMode}.`,
      `Canvas policy: ${isProjectRequest ? "open right preview with generated artifact" : "keep response in chat unless code artifact is explicitly requested"}.`,
      "If backend answer is weak, empty, or only says done, use the local Malik fallback and still give a useful result.",
      "Never break /api/stream. Never require secrets on the frontend. Never pretend a deploy happened.",
      ...attachmentRules,
    ].join("\n"),
  }
}

