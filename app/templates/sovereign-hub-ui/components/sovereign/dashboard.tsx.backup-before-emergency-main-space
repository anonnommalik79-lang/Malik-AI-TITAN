}

const dashboardEventBus = new SovereignDashboardEventBus()

const localProjectHistory = {
  key: "malik_local_project_history_v2",

  read(): LocalProjectHistoryItem[] {
    const raw = safeGetStorage(this.key, "[]")
    const parsed = safeJsonParse<LocalProjectHistoryItem[]>(raw, [])
    return Array.isArray(parsed) ? parsed.slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxHistoryItems) : []
  },

  write(items: LocalProjectHistoryItem[]): void {
    safeSetStorage(this.key, JSON.stringify(items.slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxHistoryItems)))
  },

  push(item: Omit<LocalProjectHistoryItem, "id" | "createdAt" | "updatedAt"> & Partial<Pick<LocalProjectHistoryItem, "id" | "createdAt" | "updatedAt">>): LocalProjectHistoryItem {
    const now = new Date().toISOString()
    const nextItem: LocalProjectHistoryItem = {
      id: item.id || createDashboardRuntimeId("project"),
      title: item.title || "Malik project",
      prompt: item.prompt || "",
      createdAt: item.createdAt || now,
      updatedAt: item.updatedAt || now,
      mode: item.mode || "canvas",
      view: item.view || "home",
      status: item.status || "ready",
      techStack: item.techStack || ["React", "Tailwind"],
      artifactId: item.artifactId,
      checksum: item.checksum,
      summary: item.summary,
    }
    const next = [nextItem, ...this.read().filter((entry) => entry.id !== nextItem.id)]
    this.write(next)
    dashboardEventBus.emit({
      type: "history:save",
      source: "localProjectHistory",
      view: nextItem.view,
      payload: { id: nextItem.id, title: nextItem.title, status: nextItem.status },
    })
    return nextItem
  },

  search(query: string): LocalProjectHistoryItem[] {
    const q = String(query || "").toLowerCase()
    if (!q) return this.read()
    return this.read().filter((item) =>
      `${item.title} ${item.prompt} ${item.summary || ""}`.toLowerCase().includes(q)
    )
  },
}

const canvasArtifactManager = {
  key: "malik_canvas_artifacts_v2",

  read(): CanvasArtifact[] {
    const raw = safeGetStorage(this.key, "[]")
    const parsed = safeJsonParse<CanvasArtifact[]>(raw, [])
    return Array.isArray(parsed) ? parsed.slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxCanvasArtifacts) : []
  },

  write(items: CanvasArtifact[]): void {
    safeSetStorage(this.key, JSON.stringify(items.slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxCanvasArtifacts)))
  },

  create(input: CanvasArtifactInput): CanvasArtifact {
    const now = new Date().toISOString()
    const code = String(input.code || "").slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxArtifactCodeChars)
    const checksum = checksumText(code)
    return {
      id: createDashboardRuntimeId("artifact"),
      title: String(input.title || input.prompt || "Malik AI Canvas").slice(0, DASHBOARD_SAFE_RENDER_LIMITS.maxPromptCharsForTitle),
      prompt: String(input.prompt || input.title || ""),
      code,
      language: input.language || (/<html|<!doctype/i.test(code) ? "html" : "tsx"),
      kind: input.kind || "website",
      source: input.source || "dashboard",
      createdAt: now,
      updatedAt: now,
      version: 1,
      checksum,
      size: code.length,
    }
  },

  save(artifact: CanvasArtifact): CanvasArtifact {
    const existing = this.read()
    const previous = existing.find((item) => item.checksum === artifact.checksum)
    const nextArtifact: CanvasArtifact = previous
      ? { ...artifact, id: previous.id, createdAt: previous.createdAt, version: previous.version + 1, updatedAt: new Date().toISOString() }
      : artifact
    this.write([nextArtifact, ...existing.filter((item) => item.id !== nextArtifact.id)])
    dashboardEventBus.emit({
      type: "canvas:save",
      source: "canvasArtifactManager",
      view: "home",
      payload: { id: nextArtifact.id, title: nextArtifact.title, size: nextArtifact.size },
    })
    return nextArtifact
  },

  latest(): CanvasArtifact | null {
    return this.read()[0] || null
  },

  manifest(): Pick<CanvasArtifact, "id" | "title" | "kind" | "language" | "updatedAt" | "version" | "size">[] {
    return this.read().map((item) => ({
      id: item.id,
      title: item.title,
      kind: item.kind,
      language: item.language,
      updatedAt: item.updatedAt,
      version: item.version,
      size: item.size,
    }))
  },
}

