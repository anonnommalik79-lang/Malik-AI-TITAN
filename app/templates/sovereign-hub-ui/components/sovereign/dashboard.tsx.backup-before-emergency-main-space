        media_type: attachments.find(a => a.base64)?.mime,
        mode: isProjReq ? "pro" : isCodeReq ? "code" : "chat",
        responseMode: mode,
        forceCanvas: isProjReq,
        isProjectRequest: isProjReq,
        isCodeRequest: isCodeReq,
        platform: "malik-ai-sovereign-v7",
        history,
        client: {
          surface: "dashboard",
          preview: isProjReq,
          language: "ru",
          product: "Malik AI Sovereign",
          noShortAnswers: true,
          disableReadyOnly: true,
          expectedOutput: isProjReq ? "single-large-code-block" : isCodeReq ? "code-and-explanation" : "helpful-chat-answer",
        },
        quality: {
          minimumAnswerChars: isProjReq ? 1200 : 80,
          retryIfShort: true,
          neverReturnOnly: ["Готово", "Ок", "Done", "Yes"],
        },
        capabilities: {
          chat: true,
          code: true,
          canvas: isProjReq,
          multimodalRequested: /фото|изображ|картин|video|видео|file|файл/i.test(cleanContent),
        },
      }),
    })

    if (!response.ok) throw new Error(`Server returned ${response.status}`)

    const reader = response.body?.getReader()
    if (!reader) throw new Error("No response body reader")

    const decoder = new TextDecoder()
    let fullText = ""

    while (true) {
      const { done, value } = await reader.read()
      if (done) break

      const chunkText = decoder.decode(value, { stream: true })
      const lines = chunkText.split('\n')

      for (const line of lines) {
        if (!line.startsWith('data: ')) continue
        const data = line.slice(6).trim()
        if (!data || data === '[DONE]') continue

        try {
          const parsed = JSON.parse(data)
          if (parsed?.error) throw new Error(parsed.error)
          const chunkContent = normalizeStreamChunk(parsed)
          if (chunkContent !== null && chunkContent !== undefined) {
            fullText += String(chunkContent)
          }
        } catch (e) {
          if (data && !data.startsWith('{')) {
            fullText += data.replace(/\\n/g, '\n')
          }
        }

        if (fullText) {
          setStreamingText(fullText)
          setMessages(prev =>
            prev.map(m =>
              m.id === assistantMessage.id ? { ...m, content: fullText } : m
            )
          )
        }
      }
    }

    if (isWeakBackendAnswer(fullText)) {
      const elapsed = Date.now() - startTime
      if (isProjReq && elapsed < MIN_TERMINAL_TIME) {
        await new Promise(res => setTimeout(res, MIN_TERMINAL_TIME - elapsed))
      }
      setIsGeneratingTerminal(false)

      if (isProjReq) {
        // Backend вернул слабое “Готово”, но пользователь просил проект.
        // Включаем локальный Sovereign fallback: создаём полноценный preview/code вместо пустого ответа.
        const responseText = generateMockResponse(cleanContent)
        const codeText = generateMockCode(cleanContent)
        finalizeAssistant(responseText, codeText)
      } else {
        finalizeAssistant(buildLocalChatAnswer(cleanContent, mode), undefined)
      }
      return
    }

    let { text: cleanText, code } = extractCodeBlocks(fullText, mode)

    // TERMINATOR CANVAS GUARANTEE:
    // Если внешний провайдер сказал “сгенерировано”, но не дал код,
    // canvas всё равно получает полноценный локальный preview, а не пустой чат.
    if (isProjReq && (!code || code.trim().split("\n").length < 25)) {
      cleanText = cleanText || fullText || generateMockResponse(cleanContent)
      code = generateMockCode(cleanContent)
    }

    const elapsed = Date.now() - startTime
    if (isProjReq && elapsed < MIN_TERMINAL_TIME) {
      await new Promise(res => setTimeout(res, MIN_TERMINAL_TIME - elapsed))
    }

    setIsGeneratingTerminal(false)
    dashboardEventBus.emit({
      type: "stream:finish",
      source: "handleSendMessage",
      view: activeViewRef.current,
      payload: { chatId, mode, hasCode: Boolean(code), textLength: (cleanText || fullText || "").length },
    })
    finalizeAssistant(cleanText || fullText, code)
  } catch (error) {
    console.error("Streaming error:", error)
    dashboardEventBus.emit({
      type: "runtime:error",
      source: "handleSendMessage",
      view: activeViewRef.current,
      payload: error instanceof Error ? error.message : error,
    })
    const errorMessage = `⚠️ **Ошибка соединения**\n\nСервер недоступен или вернул ошибку. Malik AI включил безопасный fallback.\n\n${error instanceof Error ? error.message : 'Неизвестная ошибка'}`
    setErrorNotification(errorMessage)

    const elapsed = Date.now() - startTime
    if (isProjReq && elapsed < MIN_TERMINAL_TIME) {
      await new Promise(res => setTimeout(res, MIN_TERMINAL_TIME - elapsed))
    }

    setIsGeneratingTerminal(false)

    if (isProjReq) {
      const responseText = generateMockResponse(cleanContent)
      const codeText = generateMockCode(cleanContent)
      finalizeAssistant(responseText, codeText)
    } else {
      finalizeAssistant(buildLocalChatAnswer(cleanContent, mode), undefined)
    }
  } finally {
    setIsLoading(false)
    setStreamingText("")
  }
