function getDashboardActionByIntent(prompt: string): DashboardActionRegistryEntry | null {
  const t = String(prompt || "").toLowerCase()
  const ranked = Object.values(DASHBOARD_ACTION_REGISTRY)
    .map((action) => ({
      action,
      score: action.keywords.filter((keyword) => t.includes(keyword.toLowerCase())).length,
    }))
    .sort((a, b) => b.score - a.score)
  return ranked[0]?.score ? ranked[0].action : null
}

function buildDashboardRuntimeDiagnostics() {
  const groups = SOVEREIGN_POWER_PACKS.reduce<Record<string, number>>((acc, item) => {
    acc[item.group] = (acc[item.group] || 0) + 1
    return acc
  }, {})
  return {
    views: DASHBOARD_SAFE_VIEW_IDS.length,
    actions: Object.keys(DASHBOARD_ACTION_REGISTRY).length,
    powerPacks: SOVEREIGN_POWER_PACKS.length,
    groups,
    latestArtifact: canvasArtifactManager.latest()?.title || null,
    eventMemory: dashboardEventBus.history().length,
  }
}



