{
  "name": "malik-ai-sovereign-hub",
  "version": "1.0.0-beta.2",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "build:render": "next build",
    "start": "next start",
    "launch": "npm run build && npm run start",
    "lint": "eslint .",
    "test:models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-malik-models.mjs",
    "test:models:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-malik-models-live.mjs",
    "test:voice": "node scripts/verify-voice-mode.mjs && node scripts/verify-voice-audio.mjs && node scripts/verify-voice-intent.mjs",
    "test:auth-audio": "node scripts/verify-auth-audio.mjs",
    "test:voice:live": "node scripts/verify-voice-live.mjs",
    "test:account": "node scripts/verify-account-and-search.mjs",
    "test:compute": "node scripts/verify-malik-compute.mjs && node scripts/verify-malik-compute-live.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','out']) if (fs.existsSync(p)) fs.rmSync(p,{recursive:true,force:true});\"",
    "test:attachment-menu": "node scripts/verify-attachment-menu.mjs",
    "test:media": "node scripts/verify-media-urls.mjs",
    "test:taxi": "node scripts/verify-taxi.mjs",
    "test:image-prompt": "node scripts/verify-image-prompt.mjs",
    "test:image-memory": "node scripts/verify-image-memory-safety.mjs",
    "test:sites": "node scripts/verify-sites.mjs",
    "test:voice:understanding": "node scripts/verify-voice-understanding.mjs",
    "test:video-speed": "node scripts/verify-video-speed.mjs",
    "test:coding-models": "node scripts/verify-coding-models.mjs",
    "test:answer-format": "node scripts/verify-answer-format.mjs",
    "test:responses": "node scripts/verify-response-quality.mjs",
    "test:action-os": "node scripts/verify-action-os.mjs",
    "test:image-quality": "node scripts/verify-image-quality.mjs",
    "test:generation-survives": "node scripts/verify-generation-survives.mjs",
    "test:library": "node scripts/verify-library.mjs"
  },
