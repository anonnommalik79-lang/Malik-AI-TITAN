# MALIK SHORTS — example only. Never commit real secrets.

# Existing Malik AI persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube discovery (server-side Data API key)
YOUTUBE_API_KEY=

# YouTube creator connection / OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://malikaiworld.world/api/youtube/callback

# TikTok Login Kit / Display API
# Keep sandbox until the first TikTok review/demo is complete.
TIKTOK_ENV=sandbox
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://malikaiworld.world/api/tiktok/callback

# 32+ char secret, or 64-char hex, or 32-byte base64. Used for AES-256-GCM at rest.
MALIK_SHORTS_TOKEN_ENCRYPTION_KEY=

# 32+ char independent bearer secret used only by trusted background workers
# (media transcoding, caption/dub jobs, Creator Agents and scheduled publishing).
MALIK_SHORTS_WORKER_TOKEN=

# Media-worker process. The worker only needs the bearer token + FFmpeg/FFprobe.
# It asks the Malik Shorts server for signed rendition upload URLs, so R2/S3
# access keys stay ONLY on the main Malik AI web service.
MALIK_SHORTS_WORKER_BASE_URL=https://malikaiworld.world
MALIK_SHORTS_WORKER_ID=media-ffmpeg-1
MALIK_SHORTS_MEDIA_POLL_SECONDS=3
MALIK_SHORTS_MEDIA_HTTP_TIMEOUT_SECONDS=180
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Optional server-side moderation provider. HTTPS only.
# If omitted, Malik Shorts still performs local anti-spam/abuse preflight.
MALIK_SHORTS_MODERATION_WEBHOOK=
MALIK_SHORTS_MODERATION_TOKEN=

# Cloudflare R2 or another S3-compatible object store.
# These credentials belong to the MAIN WEB SERVICE only.
# Example R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MALIK_SHORTS_S3_ENDPOINT=
MALIK_SHORTS_S3_REGION=auto
MALIK_SHORTS_S3_BUCKET=
MALIK_SHORTS_S3_ACCESS_KEY_ID=
MALIK_SHORTS_S3_SECRET_ACCESS_KEY=
# Public custom domain/CDN for the bucket, no trailing slash.
MALIK_SHORTS_PUBLIC_CDN_URL=
