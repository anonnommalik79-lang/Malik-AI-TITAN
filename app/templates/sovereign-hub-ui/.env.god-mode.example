# ═══════════════════════════════════════════════════════════════════
# MALIK AI — GOD MODE TEMPLATE
# ═══════════════════════════════════════════════════════════════════
# 1. Скопируй этот файл:
#    copy .env.god-mode.example .env.local
# 2. Вставь свои ключи вместо пустых значений после =
# 3. НИКОГДА не коммить .env.local в GitHub
# ═══════════════════════════════════════════════════════════════════

# ── APP ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── GOD MODE: все провайдеры разрешены (платные тоже) ─────────────
AI_FREE_MODE=false

# ── CHAT / BRAIN — минимум 1 бесплатный + премиум для полной мощи ─
# Бесплатные (хотя бы один обязателен для старта):
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Премиум текст (GOD MODE):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# Модели (можно не трогать)
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_MODEL=gemini-1.5-pro
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CODE_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DEEPSEEK_MODEL=deepseek-chat
GROK_MODEL=grok-3-mini
KIMI_MODEL=kimi-k2.5

# Amazon Bedrock (опционально, для текста/кода — не для /api/media)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── MEDIA — картинки и видео (новая система /api/media/*) ───────
STABILITY_API_KEY=
POLLO_API_KEY=

IMAGE_PROVIDER_PRIMARY=stability
IMAGE_PROVIDER_FALLBACK=pollinations
IMAGE_FREE_MODE=false

POLLO_VIDEO_MODEL=pollo-v2-0
VIDEO_PROVIDER_PRIMARY=pollo
POLLO_VIDEO_ENABLED=true

# GOD MODE лимиты (щедрые)
GUEST_DAILY_IMAGE_LIMIT=10
FREE_DAILY_IMAGE_LIMIT=50
PREMIUM_DAILY_IMAGE_LIMIT=200
GUEST_DAILY_VIDEO_LIMIT=0
FREE_DAILY_VIDEO_LIMIT=5
PREMIUM_DAILY_VIDEO_LIMIT=20
MAX_IMAGE_PROMPT_LENGTH=1500
MAX_VIDEO_PROMPT_LENGTH=1500

# ── WORKOS AUTHKIT — логин Google/GitHub и защищённая сессия ──────
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ── STORAGE — загрузка файлов (опционально) ───────────────────────
R2_BUCKET=
CLOUDFLARE_R2_BUCKET=
S3_BUCKET=
STORAGE_BUCKET=

# ── ADMIN / OWNER — без лимитов для твоего email ──────────────────
MALIK_ADMIN_USERS=твой@email.com
MALIK_DEBUG_PROVIDERS=true

# ── UPLOADS ───────────────────────────────────────────────────────
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_VIDEO_MB=50
MAX_UPLOAD_DOC_MB=12

# ── TIMEOUTS ──────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=45000
IMAGE_PROVIDER_TIMEOUT_MS=120000
POLLINATIONS_TIMEOUT_MS=45000
