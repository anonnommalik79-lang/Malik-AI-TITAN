# Malik AI environment variables
# Copy to .env for local development only. Never commit real keys.

# Core LLM / Codex providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MALIK_CODEX_PROVIDER=openai
MALIK_CODEX_MODEL=gpt-5.5
MALIK_CODEX_SESSION_LIMIT=20
MALIK_CODEX_TASK_LIMIT=6
MALIK_CODEX_PROVIDER_FALLBACK=0
MALIK_CODEX_AUTO_MODE=0
MALIK_CODEX_MONTHLY_LIMIT_USD=0

# Database / auth
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MALIK_ADMIN_USERS=

# Malik Taxi / official Uber Riders API
# Keep sandbox until Uber approves public production access for ride booking.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_REDIRECT_URI=https://malikaiworld.world/api/taxi/uber/callback
UBER_SCOPES=profile offline_access ride_request.ride_booking ride_request.place ride_request.estimate
UBER_TOKEN_ENCRYPTION_KEY=
UBER_API_MODE=sandbox

# Media access guard
MEDIA_PRO_ACCESS_CODE=
MEDIA_VIDEO_PROVIDER_ORDER=fal-video,luma-video,runway-video,fal-kling-pro-video,google-veo,pika-video,kling-video,replicate-video
MEDIA_PRO_VIDEO_PROVIDER_ORDER=google-veo,runway-video,fal-kling-pro-video,luma-video,fal-video,pika-video,kling-video,replicate-video

# Photo generation
OPENAI_IMAGE_URL=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
STABILITY_API_KEY=
STABILITY_IMAGE_URL=
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_URL=
FAL_KEY=
FAL_IMAGE_URL=
LEONARDO_API_KEY=
LEONARDO_IMAGE_URL=

# MalikVideo 1.0
# Recommended production shape:
# Malik AI -> MalikVideo Worker -> MiniMax H3 768p master -> SeedVR2 -> 1080p/2K -> MP4
# Keep disabled until the worker /health and smoke test both pass.
VIDEO_PROVIDER_ORDER=h3,dashscope,pollo,runway,fal,luma,veo
MALIKVIDEO_H3_ENABLED=false
MALIKVIDEO_H3_MODE=worker
MALIKVIDEO_H3_BASE_URL=
# Same private bearer token configured as MALIKVIDEO_WORKER_API_KEY on the GPU worker.
MALIKVIDEO_H3_API_KEY=
MALIKVIDEO_H3_MODEL=MalikVideo-1.0
MALIKVIDEO_H3_SEED=0
MALIKVIDEO_H3_SUBMIT_TIMEOUT_MS=30000
MALIKVIDEO_H3_STATUS_TIMEOUT_MS=15000

# GPU-side MalikVideo Worker settings (set on the GPU machine/container, not Render).
MALIKVIDEO_WORKER_API_KEY=
MALIKVIDEO_UPSTREAM_H3_URL=http://127.0.0.1:30010
MALIKVIDEO_UPSTREAM_H3_API_KEY=
MALIKVIDEO_DATA_DIR=/data/malikvideo
MALIKVIDEO_ENHANCER=seedvr2
MALIKVIDEO_SEEDVR_ROOT=/opt/SeedVR
MALIKVIDEO_SEEDVR_GPUS=4
MALIKVIDEO_SEEDVR_SCRIPT=projects/inference_seedvr2_3b.py
MALIKVIDEO_POLL_SECONDS=5
MALIKVIDEO_HTTP_TIMEOUT_SECONDS=30

# Existing hosted video fallbacks
FAL_VIDEO_URL=https://fal.run/fal-ai/wan/v2.7/text-to-video
FAL_PRO_VIDEO_URL=https://fal.run/fal-ai/kling-video/o3/4k/text-to-video
GOOGLE_VEO_API_KEY=
GEMINI_API_KEY=
GOOGLE_VEO_VIDEO_URL=https://generativelanguage.googleapis.com/v1beta/models/veo-3.1-generate-preview:predictLongRunning
GOOGLE_VEO_MODEL=veo-3.1-generate-preview
GOOGLE_VEO_RESOLUTION=720p
GOOGLE_VEO_DURATION_SECONDS=8
GOOGLE_VEO_NEGATIVE_PROMPT=cartoon, drawing, low quality, distorted, blurry
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
RUNWAY_VIDEO_URL=https://api.dev.runwayml.com/v1/text_to_video
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_API_VERSION=2024-11-06
LUMA_API_KEY=
LUMAAI_API_KEY=
LUMA_VIDEO_URL=https://api.lumalabs.ai/dream-machine/v1/generations
LUMA_VIDEO_MODEL=ray-2
LUMA_VIDEO_RESOLUTION=720p
LUMA_VIDEO_DURATION=5s
PIKA_API_KEY=
PIKA_VIDEO_URL=
KLING_API_KEY=
KLING_VIDEO_URL=
REPLICATE_VIDEO_URL=

# Direct key pages:
# OpenAI: https://platform.openai.com/api-keys
# Stability AI: https://platform.stability.ai/account/keys
# Replicate: https://replicate.com/account/api-tokens
# fal.ai: https://fal.ai/dashboard/keys
# Leonardo AI: https://app.leonardo.ai/api-access
# Runway: https://dev.runwayml.com/
# Luma Dream Machine: https://lumalabs.ai/dream-machine/api/keys
# Google Veo / Gemini: https://aistudio.google.com/app/apikey
# Pika API: https://pika.art/api
# Kling API: https://klingapi.com/docs
